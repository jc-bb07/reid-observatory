ents":85.0,"gdp_real_2324_prices_m":5840},"2024-25":{"customs":521.65,"incometax":388.53,"other_treasury":5.28,"deptfees":149.76,"penscon":43.65,"ni_rec":328.46,"total_income":1437.33,"emp":491.72,"erpension":53.42,"penrev":89.87,"nonemp":343.15,"niwelfare":330.38,"revwelfare":86.47,"sinking":3.5,"cfr":64.0,"intfunds":37.85,"total_exp":1465.09,"surplus":14.4,"pension_gross":143.0,"pension_emp_contrib":-44.0,"pension_dept_contrib":-53.0,"pension_rev_liability":46.0,"ni_contributions":278.6,"ni_fund_cf":975.9,"cap_balance_cf":3.77,"cap_receipts":14.3,"cap_payments":85.0},"2025-26":{"cfr_receipts":5.18,"cfr_payments":-60.0,"cap_balance_cf":3.82,"customs":473.55,"incometax":384.04,"other_treasury":11.23,"deptfees":150.61,"penscon":39.85,"ni_rec":329.74,"total_income":1389.02,"emp":507.24,"erpension":62.63,"penrev":80.29,"nonemp":345.28,"niwelfare":353.55,"revwelfare":87.94,"sinking":3.5,"cfr":19.0,"intfunds":41.75,"total_exp":1458.05,"surplus":1.26,"pension_gross":143.0,"pension_emp_contrib":-40.0,"pension_dept_contrib":-63.0,"pension_rev_liability":40.0,"ni_contributions":273.7,"ni_fund_cf":992.5},"2026-27":{"cfr_receipts":4.5,"cfr_payments":-50.0,"cap_surplus":-67.64,"cap_balance_cf":2.64,"customs":496.22,"incometax":413.37,"other_treasury":13.36,"deptfees":151.4,"penscon":48.45,"ni_rec":347.04,"total_income":1469.84,"emp":543.4,"erpension":61.84,"penrev":98.87,"nonemp":376.25,"niwelfare":375.2,"revwelfare":95.71,"sinking":3.5,"cfr":10.0,"intfunds":43.95,"total_exp":1545.05,"surplus":1.64,"pension_gross":161.0,"pension_emp_contrib":-48.0,"pension_dept_contrib":-62.0,"pension_rev_liability":51.0,"ni_contributions":292.1,"ni_welfare_exp":287.5,"ni_fund_cf":999.4}};

const YEAR_TYPES = {"2017-18":"actuals","2018-19":"actuals","2019-20":"actuals","2020-21":"actuals","2021-22":"actuals","2022-23":"actuals","2023-24":"actuals","2024-25":"actuals","2025-26":"budget","2026-27":"budget"};

