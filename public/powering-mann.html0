<div class="tip" id="tip"></div>
<script>
(function(){
"use strict";
/* ---------- reading mode ---------- */
function setMode(m){
  document.body.classList.toggle('quick',m==='quick');
  document.querySelectorAll('#modeSeg button').forEach(function(b){
    b.classList.toggle('on',b.dataset.mode===m);});
}
document.querySelectorAll('#modeSeg button').forEach(function(b){
  b.addEventListener('click',function(){setMode(b.dataset.mode);});});
if(window.innerWidth<720)setMode('quick');

/* ---------- theme ---------- */
var themeBtn=document.getElementById('themeBtn');
var order=['auto','dark','light'];var ti=0;
themeBtn.addEventListener('click',function(){ti=(ti+1)%3;var t=order[ti];
  if(t==='auto'){document.documentElement.removeAttribute('data-theme');themeBtn.textContent='◐ Theme';}
  else{document.documentElement.setAttribute('data-theme',t);themeBtn.textContent=(t==='dark'?'● Dark':'○ Light');}
  renderAll();});

/* ---------- helpers ---------- */
var tip=document.getElementById('tip');
function showTip(html,x,y){tip.innerHTML=html;tip.style.opacity=1;
  var w=tip.offsetWidth,h=tip.offsetHeight;
  var px=Math.min(x+14,window.innerWidth-w-10),py=y-h-12;if(py<8)py=y+16;
  tip.style.left=px+'px';tip.style.top=py+'px';}
function hideTip(){tip.style.opacity=0;}
function cssVar(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim();}
function el(tag,attrs){var e=document.createElementNS('http://www.w3.org/2000/svg',tag);
  for(var k in attrs)e.setAttribute(k,attrs[k]);return e;}
function fmt(n,d){return n.toLocaleString('en-GB',{maximumFractionDigits:d==null?0:d,minimumFractionDigits:0});}
function hover(node,html){
  node.style.cursor='default';
  node.addEventListener('mousemove',function(ev){showTip(html,ev.clientX,ev.clientY);});
  node.addEventListener('mouseleave',hideTip);}

/* ---------- constants ---------- */
var MONTHS=['J','F','M','A','M','J','J','A','S','O','N','D'];
var DSH=[0.105,0.095,0.09,0.08,0.072,0.065,0.062,0.065,0.075,0.088,0.098,0.105];
var SSH=[0.03,0.05,0.085,0.115,0.13,0.135,0.13,0.11,0.085,0.055,0.04,0.035];
var HOURS=[744,672,744,720,744,720,744,744,720,744,720,744];
var HORIZONS={
  '2030':{gwh:385,peak:82,impG:100,icNew:false,hint:'Existing 60 MW cable still in service; new links arrive next phase. Pulrose still available.'},
  '2035':{gwh:430,peak:95,impG:50,icNew:true,hint:'Pulrose retired (~2033). Old cable at end of life (~2035). New links carry the system.'},
  '2045':{gwh:500,peak:115,impG:25,icNew:true,hint:'Deep heat and transport electrification. Peak heading toward the ~130 MW 2050 projection.'}};
var state={h:'2030'};

/* ---------- model ---------- */
function readState(){
  state.roof=+document.getElementById('r_roof').value;
  state.ground=+document.getElementById('r_ground').value;
  state.bess=+document.getElementById('r_bess').value;
  state.comm=+document.getElementById('r_comm').value;
  state.v2g=+document.getElementById('r_v2g').value;
  state.flex=+document.getElementById('r_flex').value;
  state.gas=+document.getElementById('r_gas').value;
  state.dc=+document.getElementById('r_dc').value;
  state.ic1=document.getElementById('t_ic1').checked;
  state.ic2=document.getElementById('t_ic2').checked;
}
function compute(){
  var H=HORIZONS[state.h];
  var isNew=H.icNew;
  var ic1Cap=state.ic1?(isNew?100:60):0;      /* import capability MW */
  var ic1Firm=state.ic1?(isNew?100:40):0;     /* firm continuous MW  */
  var ic2Cap=(state.ic2&&isNew)?100:0;
  var ic2Firm=ic2Cap;
  var solarMW=state.roof+state.ground;
  var solarG=solarMW*8.76*0.105;
  var dcEnergy=state.dc*8.76*0.9;             /* near-flat load at 90% utilisation */
  var energy=H.gwh*(1-state.flex*0.004)+dcEnergy;
  var months=[],imports=0,gasG=0,solUsed=0,exportG=0,curtG=0;
  var efwG=32,hydG=4;
  for(var m=0;m<12;m++){
    var dem=energy*DSH[m];
    var sol=solarG*SSH[m];
    var base=(efwG+hydG)/12;
    var net=dem-base-sol;
    var row={dem:dem,base:base};
    if(net>=0){
      row.sol=sol;solUsed+=sol;
      var impCap=(ic1Cap+ic2Cap)*HOURS[m]*0.85/1000;
      row.imp=Math.min(net,impCap);imports+=row.imp;
      row.gas=Math.max(0,net-row.imp);gasG+=row.gas;
    }else{
      row.sol=dem-base;solUsed+=row.sol;
      var spare=sol-row.sol;
      var expCap=(ic1Cap+ic2Cap)*HOURS[m]*0.3/1000;
      var ex=Math.min(spare,expCap);exportG+=ex;curtG+=spare-ex;
      row.imp=0;row.gas=0;
    }
    months.push(row);
  }
  /* winter security */
  var peak=H.peak*(1-state.flex/100)+state.dc*0.95;  /* flexibility trims native load, not the datacentre */
  var v2gMW=state.v2g*7*0.3/1000;
  var commMW=state.comm/2;
  var pulrose=(!isNew)?0:0; /* Pulrose folded into gas slider at 2030 via max 85 */
  var firmParts={
    'Interconnectors':ic1Firm+ic2Firm,
    'Utility + community batteries':state.bess+commMW,
    'V2G fleet':v2gMW,
    'Gas / diesel standby':state.gas,
    'EfW + hydro':6.7};
  var firmTotal=0;for(var k in firmParts)firmTotal+=firmParts[k];
  var largestName='',largest=0;
  var cands={'Interconnector link':Math.max(ic1Firm,ic2Firm),
             'largest battery station':state.bess*0.5,
             'largest gas station':state.gas*0.5};
  for(var c in cands){if(cands[c]>largest){largest=cands[c];largestName=c;}}
  var margin=firmTotal-largest-peak;
  /* carbon */
  var totalG=solUsed+efwG+hydG+imports+gasG;
  var carbon=totalG>0?(gasG*400+imports*H.impG)/totalG:0;
  var cleanShare=(solUsed+hydG+imports)/(totalG)*100;
  var solShare=solUsed/totalG*100;
  /* capex */
  var capex=0;
  capex+=state.roof*1.2+state.ground*0.75;
  capex+=state.bess*0.68+state.comm*0.29;
  capex+=state.v2g*1500/1e6;
  capex+=state.flex*3.2;
  if(isNew&&state.ic1)capex+=200;
  if(isNew&&state.ic2)capex+=200;
  if(isNew)capex+=20;                     /* syncons */
  if(isNew&&state.gas>0)capex+=15;        /* standby life-extension */
  /* indicative unit-cost delta vs today's fuel stack (~7.2p fuel within 29.5p) */
  var annCharge=(state.roof*1.2+state.ground*0.75+state.flex*3.2+((isNew&&state.ic1)?200:0)+((isNew&&state.ic2)?200:0)+(isNew?20:0))*0.0782
               +(state.bess*0.68+state.comm*0.29+state.v2g*1500/1e6+((isNew&&state.gas>0)?15:0))*0.103;
  var fuel=imports*0.09+gasG*0.08;
  var scenP=(annCharge+fuel)/totalG*100;
  /* counterfactual: keep the gas model. Post-2033/35 that still means replacing the
     cable (~£200m) and the CCGT (~£80m); before then it is just fuel. */
  var cfCapex=isNew?(280*0.0782):0;
  var baseP=(cfCapex+H.gwh*0.9*0.08)/H.gwh*100;
  var deltaP=scenP-baseP;
  return {months:months,imports:imports,gas:gasG,solUsed:solUsed,efwG:efwG,hydG:hydG,
    exportG:exportG,curtG:curtG,peak:peak,firmParts:firmParts,firmTotal:firmTotal,
    largest:largest,largestName:largestName,margin:margin,carbon:carbon,
    cleanShare:cleanShare,solShare:solShare,capex:capex,deltaP:deltaP,H:H};
}

/* ---------- outputs ---------- */
function renderOuts(r){
  document.getElementById('x_clean').textContent=fmt(r.cleanShare,0)+'%';
  document.getElementById('x_solar').textContent=fmt(r.solShare,0)+'%';
  document.getElementById('x_margin').textContent=(r.margin>=0?'+':'')+fmt(r.margin,0)+' MW';
  var b=document.getElementById('x_marginBadge');
  var pct=r.margin/r.peak*100;
  if(r.margin<0){b.innerHTML='<span style="color:var(--crit)">&#9632; shortfall: load shedding risk</span>';}
  else if(pct<10){b.innerHTML='<span style="color:var(--serious)">&#9632; tight: little room for error</span>';}
  else{b.innerHTML='<span style="color:var(--good)">&#9632; secure under N-1</span>';}
  document.getElementById('x_carbon').textContent=fmt(r.carbon,0)+' g';
  document.getElementById('x_capex').textContent='£'+fmt(r.capex,0)+'m';
  var d=r.deltaP;
  document.getElementById('x_bill').textContent=(d>=0?'+':'−')+fmt(Math.abs(d),1)+'p/kWh';
  var noteBits='Exports '+fmt(r.exportG,0)+' GWh · curtailed '+fmt(r.curtG,1)+' GWh · imports '+fmt(r.imports,0)+' GWh · gas '+fmt(r.gas,0)+' GWh. '
    +'N-1 removes the '+r.largestName+' ('+fmt(r.largest,0)+' MW). '
    +'The cost figure compares fuel plus new-asset financing against a counterfactual that replaces the gas plant and cable like-for-like; neither side prices fuel volatility or carbon.';
  document.getElementById('modelNote').textContent=noteBits;
}

/* ---------- mix chart ---------- */
function renderMix(r){
  var svg=document.getElementById('mixChart');svg.innerHTML='';
  var W=960,Hh=320,pl=46,pr=10,pt=14,pb=30;
  var iw=W-pl-pr,ih=Hh-pt-pb;
  var series=[
    {k:'imp',n:'Imports',c:cssVar('--s1')},
    {k:'gas',n:'Gas',c:cssVar('--s2')},
    {k:'base',n:'EfW + hydro',c:cssVar('--s6')},
    {k:'sol',n:'Island solar',c:cssVar('--s4')}];
  var max=0;r.months.forEach(function(mo){max=Math.max(max,mo.imp+mo.gas+mo.base+mo.sol);});
  max=Math.ceil(max/10)*10||10;
  for(var g=0;g<=4;g++){var y=pt+ih-ih*g/4;
    svg.appendChild(el('line',{x1:pl,x2:W-pr,y1:y,y2:y,stroke:cssVar('--grid'),'stroke-width':1}));
    var t=el('text',{x:pl-8,y:y+4,'text-anchor':'end','class':'axis-t'});t.textContent=fmt(max*g/4,0);svg.appendChild(t);}
  var bw=iw/12*0.62;
  r.months.forEach(function(mo,i){
    var x=pl+iw*(i+0.5)/12-bw/2;var y0=pt+ih;
    var tot=mo.imp+mo.gas+mo.base+mo.sol;
    series.forEach(function(s,si){
      var v=mo[s.k];if(v<=0.01)return;
      var h=ih*v/max;y0-=h;
      var isTop=(function(){for(var j=si+1;j<series.length;j++){if(mo[series[j].k]>0.01)return false;}return true;})();
      var rect=el('rect',{x:x,y:y0+1,width:bw,height:Math.max(0,h-2),fill:s.c,rx:isTop?4:0});
      hover(rect,'<b>'+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][i]+'</b>'
        +s.n+': '+fmt(v,1)+' GWh<br>Month total: '+fmt(tot,1)+' GWh');
      svg.appendChild(rect);});
    var t=el('text',{x:x+bw/2,y:Hh-10,'text-anchor':'middle','class':'axis-t'});t.textContent=MONTHS[i];svg.appendChild(t);});
  svg.appendChild(el('line',{x1:pl,x2:W-pr,y1:pt+ih,y2:pt+ih,stroke:cssVar('--axis'),'stroke-width':1}));
  var lg=document.getElementById('mixLegend');lg.innerHTML='';
  series.slice().reverse().forEach(function(s){var sp=document.createElement('span');
    sp.innerHTML='<i style="background:'+s.c+'"></i>'+s.n;lg.appendChild(sp);});
  var u=el('text',{x:pl-8,y:pt-2,'text-anchor':'end','class':'axis-t'});u.textContent='GWh';svg.appendChild(u);
}

/* ---------- firm chart ---------- */
function renderFirm(r){
  var svg=document.getElementById('firmChart');svg.innerHTML='';
  var W=960,Hh=240,pl=150,pr=90,pt=16,pb=34;
  var iw=W-pl-pr;
  var colors={'Interconnectors':cssVar('--s1'),'Utility + community batteries':cssVar('--s3'),
    'V2G fleet':cssVar('--s5'),'Gas / diesel standby':cssVar('--s2'),'EfW + hydro':cssVar('--s6')};
  var max=Math.max(r.firmTotal,r.peak)*1.15||10;
  var rows=[{label:'All firm assets',scale:1,drop:null},{label:'After N-1 loss',scale:1,drop:r.largestName}];
  var bh=44,gap=36;
  rows.forEach(function(row,ri){
    var y=pt+ri*(bh+gap);var x=pl;
    var t=el('text',{x:pl-10,y:y+bh/2+4,'text-anchor':'end','class':'dl'});t.textContent=row.label;svg.appendChild(t);
    var remaining=row.drop?r.largest:0;
    var total=0;
    Object.keys(r.firmParts).forEach(function(k){
      var v=r.firmParts[k];
      if(row.drop){
        /* remove the largest asset from its own category */
        if(row.drop==='Interconnector link'&&k==='Interconnectors')v=Math.max(0,v-r.largest);
        if(row.drop==='largest battery station'&&k==='Utility + community batteries')v=Math.max(0,v-r.largest);
        if(row.drop==='largest gas station'&&k==='Gas / diesel standby')v=Math.max(0,v-r.largest);
      }
      if(v<=0.05)return;
      var w=iw*v/max;total+=v;
      var rect=el('rect',{x:x+1,y:y,width:Math.max(0,w-2),height:bh,fill:colors[k],rx:3});
      hover(rect,'<b>'+k+'</b>'+fmt(v,1)+' MW firm'+(row.drop?'<br>(after losing the '+row.drop+')':''));
      svg.appendChild(rect);x+=w;});
    var tl=el('text',{x:x+8,y:y+bh/2+4,'class':'dl'});tl.textContent=fmt(total,0)+' MW';svg.appendChild(tl);});
  var px=pl+iw*r.peak/max;
  svg.appendChild(el('line',{x1:px,x2:px,y1:pt-6,y2:pt+2*bh+gap+8,stroke:cssVar('--ink-1'),'stroke-width':1.5,'stroke-dasharray':'5 4'}));
  var pt1=el('text',{x:px,y:pt+2*bh+gap+26,'text-anchor':'middle','class':'dl'});
  pt1.textContent='winter peak after flexibility: '+fmt(r.peak,0)+' MW';svg.appendChild(pt1);
  var lg=document.getElementById('firmLegend');lg.innerHTML='';
  Object.keys(colors).forEach(function(k){if(r.firmParts[k]>0.05){var sp=document.createElement('span');
    sp.innerHTML='<i style="background:'+colors[k]+'"></i>'+k;lg.appendChild(sp);}});
}

/* ---------- asset clock ---------- */
function renderClock(){
  var svg=document.getElementById('clockChart');svg.innerHTML='';
  var W=960,Hh=300,pl=220,pr=30,pt=14,pb=30;
  var iw=W-pl-pr;
  var y0=2026,y1=2036.5;
  function X(yr){return pl+iw*(yr-y0)/(y1-y0);}
  var items=[
    {n:'EfW contract',end:2029,note:'Richmond Hill contract expires 2029; renewal decision due'},
    {n:'Water bond £75m',end:2030,note:'Repayable by March 2030'},
    {n:'Pulrose CCGT (~90% of supply)',end:2033,note:'Commissioned 2003 · end of life ~2033',crit:true},
    {n:'Electricity bond £185m',end:2034,note:'Repayable by August 2034 at ~5.4%'},
    {n:'Interconnector (2000)',end:2035,note:'104 km AC cable, commissioned Nov 2000 · end of life ~2035',crit:true}];
  for(var yr=2026;yr<=2036;yr+=2){var x=X(yr);
    svg.appendChild(el('line',{x1:x,x2:x,y1:pt,y2:Hh-pb,stroke:cssVar('--grid'),'stroke-width':1}));
    var t=el('text',{x:x,y:Hh-10,'text-anchor':'middle','class':'axis-t'});t.textContent=yr;svg.appendChild(t);}
  var bh=30,gap=16;
  items.forEach(function(it,i){
    var y=pt+10+i*(bh+gap);
    var t=el('text',{x:pl-12,y:y+bh/2+4,'text-anchor':'end','class':'dl'});t.textContent=it.n;svg.appendChild(t);
    var w=X(it.end)-X(2026);
    var seq=['#86b6ef','#6da7ec','#5598e7','#3987e5','#2a78d6'];
    var rect=el('rect',{x:X(2026),y:y,width:w,height:bh,fill:it.crit?cssVar('--s2'):seq[i],rx:4});
    hover(rect,'<b>'+it.n+'</b>'+it.note);
    svg.appendChild(rect);
    var tl=el('text',{x:X(it.end)+8,y:y+bh/2+4,'class':'dl'});tl.textContent=it.end;svg.appendChild(tl);});
  var nx=X(2026.58);
  svg.appendChild(el('line',{x1:nx,x2:nx,y1:pt,y2:Hh-pb,stroke:cssVar('--ink-1'),'stroke-width':1.5,'stroke-dasharray':'5 4'}));
  var nt=el('text',{x:nx+6,y:pt+10,'class':'dl'});nt.textContent='today';svg.appendChild(nt);
}

/* ---------- firm-cost chart ---------- */
function renderFirmCost(){
  var svg=document.getElementById('firmCostChart');svg.innerHTML='';
  var W=960,Hh=300,pl=250,pr=110,pt=14,pb=16;
  var iw=W-pl-pr;
  var items=[
    {n:'Gas / diesel life-extension',v:0.4,note:'~£15–20m keeps ~40 MW of existing standby plant alive'},
    {n:'Utility BESS (grid-forming, 2h)',v:0.7,note:'GB median ~£650k/MW plus 3–8% grid-forming premium'},
    {n:'Interconnector (100 MW)',v:2.0,note:'MU planning estimate £200m per link'},
    {n:'Efficiency & flexibility*',v:3.4,note:'~£3.2m per % of peak removed; repays through permanent energy savings too'},
    {n:'Onshore wind (winter-firm basis)*',v:7.2,note:'£43m for 20 MW; ~30% dependable on a winter evening'},
    {n:'Solar (winter-firm basis)*',v:10.7,note:'~£0.75m/MW; ~7% dependable on a winter evening. Solar is bought for energy and summer value, never for winter firmness'}];
  var max=11;
  var seq=['#86b6ef','#6da7ec','#5598e7','#3987e5','#2a78d6','#1c5cab'];
  var bh=32,gap=12;
  items.forEach(function(it,i){
    var y=pt+i*(bh+gap);
    var t=el('text',{x:pl-12,y:y+bh/2+4,'text-anchor':'end','class':'dl'});t.textContent=it.n;svg.appendChild(t);
    var w=iw*it.v/max;
    var rect=el('rect',{x:pl,y:y,width:w,height:bh,fill:seq[i],rx:4});
    hover(rect,'<b>'+it.n+'</b>£'+it.v.toFixed(1)+'m per firm winter MW<br>'+it.note);
    svg.appendChild(rect);
    var tl=el('text',{x:pl+w+8,y:y+bh/2+4,'class':'dl'});tl.textContent='£'+it.v.toFixed(1)+'m';svg.appendChild(tl);});
  var foot=el('text',{x:pl,y:Hh-2,'class':'axis-t'});
  foot.textContent='* repays through energy savings or revenue as well; this chart prices dependable winter capacity only.';
  svg.appendChild(foot);
}

/* ---------- wiring ---------- */
function renderAll(){
  readState();
  document.getElementById('o_roof').textContent=state.roof+' MW';
  document.getElementById('o_ground').textContent=state.ground+' MW';
  document.getElementById('o_bess').textContent=state.bess+' MW';
  document.getElementById('o_comm').textContent=state.comm+' MWh';
  document.getElementById('o_v2g').textContent=fmt(state.v2g,0);
  document.getElementById('o_flex').textContent=state.flex+'%';
  document.getElementById('o_gas').textContent=state.gas+' MW';
  document.getElementById('o_dc').textContent=state.dc+' MW';
  document.getElementById('horizonHint').textContent=HORIZONS[state.h].hint;
  var r=compute();
  renderOuts(r);renderMix(r);renderFirm(r);renderClock();renderFirmCost();
}
['r_roof','r_ground','r_bess','r_comm','r_v2g','r_flex','r_gas','r_dc'].forEach(function(id){
  document.getElementById(id).addEventListener('input',renderAll);});
['t_ic1','t_ic2'].forEach(function(id){
  document.getElementById(id).addEventListener('change',renderAll);});
document.querySelectorAll('#horizonSeg button').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#horizonSeg button').forEach(function(x){x.classList.remove('on');});
    b.classList.add('on');state.h=b.dataset.h;renderAll();});});
if(matchMedia)matchMedia('(prefers-color-scheme: dark)').addEventListener('change',renderAll);
renderAll();

/* ---------- Observatory embed bridge ----------
   When loaded inside the Crown Dependencies Observatory shell (AutoIframe),
   hide this page's own header, report content height to the parent, and
   follow the parent's theme messages. Standalone behaviour is unchanged. */
var embedded=false;
try{embedded=window.self!==window.top;}catch(e){embedded=true;}
if(embedded){
  /* Keep the section nav (it is the reader's map inside the scrolling iframe),
     drop the duplicate branding and theme control — the shell provides both. */
  var st=document.createElement('style');
  st.textContent='header.site .brand,#themeBtn{display:none!important}@media(max-width:720px){header.site{display:none}}';
  document.head.appendChild(st);
  document.documentElement.style.scrollBehavior='auto';
  var postH=function(){try{parent.postMessage({type:'resize',height:document.documentElement.scrollHeight+40},'*');}catch(e){}};
  window.addEventListener('message',function(ev){
    var d=ev.data||{};
    if((d.type==='setTheme'||d.type==='theme')&&d.theme){
      var t=(d.theme==='dark')?'dark':'light';
      document.documentElement.setAttribute('data-theme',t);
      renderAll();
      setTimeout(postH,80);
    }
  });
  if('ResizeObserver' in window){new ResizeObserver(function(){postH();}).observe(document.body);}
  window.addEventListener('load',postH);
  setTimeout(postH,300);setTimeout(postH,1200);
}
})();
</script>
</body>
</html>
