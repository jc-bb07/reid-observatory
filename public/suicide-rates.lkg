// ── CHART BUILDERS ────────────────────────────────────────────────────────────
let _uCharts = {};
const U_BG='#0f172a',U_GRID='rgba(51,65,85,0.5)',U_TICK='#64748b';
const U_BLUE='rgba(96,165,250,0.75)',U_BLUE9='rgba(96,165,250,0.9)',U_RED='#f87171';

function monthLabelsU(from,to){const o=[];for(let y=from;y<=to;y++)for(let m=1;m<=12;m++)o.push(`${y}-${String(m).padStart(2,'0')}`);return o;}
function qLabelsU(from,to){const o=[];for(let y=from;y<=to;y++)for(let q=1;q<=4;q++)o.push(`${y}-Q${q}`);return o;}

function commonUScales(dMax,dStep,dColor,dLabel,rMax,rStep,rColor,rLabel){
  return{
    x:{ticks:{color:U_TICK,font:{size:8},maxRotation:0,autoSkip:true,maxTicksLimit:12,
      callback(v){const l=this.getLabelForValue(v);if(!l)return'';if(l.match(/^\d{4}-01$/))return l.slice(0,4);if(l.match(/^\d{4}-Q1$/))return l.slice(0,4);return'';}},
      grid:{color:U_GRID},border:{color:U_GRID}},
    yD:{type:'linear',position:'left',min:0,max:dMax,ticks:{color:dColor,font:{size:8},stepSize:dStep},grid:{color:U_GRID},border:{color:'rgba(248,113,113,0.3)'},title:{display:true,text:dLabel,color:dColor,font:{size:7}}},
    yR:{type:'linear',position:'right',min:0,max:rMax,ticks:{color:rColor,font:{size:8},stepSize:rStep,callback:v=>rLabel.includes('%')?v.toFixed(1)+'%':v.toLocaleString()},grid:{display:false},border:{color:'rgba(96,165,250,0.25)'},title:{display:true,text:rLabel,color:rColor,font:{size:7}}}
  };
}

function mDeathStepPlugin(dBy){return{id:'mds',afterDraw(chart){const{ctx,scales:{yD,x},data:{labels}}=chart;if(!yD)return;ctx.save();ctx.strokeStyle='rgba(248,113,113,0.45)';ctx.lineWidth=2;for(const[yr,cnt]of Object.entries(dBy)){const j=`${yr}-01`,d=`${yr}-12`,ji=labels.indexOf(j),di=labels.indexOf(d);if(ji<0||di<0)continue;const x1=x.getPixelForValue(ji),x2=x.getPixelForValue(di),yp=yD.getPixelForValue(cnt);ctx.beginPath();ctx.moveTo(x1,yp);ctx.lineTo(x2,yp);ctx.stroke();}ctx.restore();}}}
function qDeathStepPlugin(dBy,solid){return{id:'qds',afterDraw(chart){const{ctx,scales:{yD,x},data:{labels}}=chart;if(!yD)return;ctx.save();ctx.strokeStyle='rgba(248,113,113,0.45)';ctx.lineWidth=solid?2:1.5;if(!solid)ctx.setLineDash([3,3]);for(const[yr,cnt]of Object.entries(dBy)){const q1=`${yr}-Q1`,q4=`${yr}-Q4`,i1=labels.indexOf(q1),i4=labels.indexOf(q4);if(i1<0||i4<0)continue;const x1=x.getPixelForValue(i1),x2=x.getPixelForValue(i4),yp=yD.getPixelForValue(cnt);ctx.beginPath();ctx.moveTo(x1,yp);ctx.lineTo(x2,yp);ctx.stroke();}ctx.setLineDash([]);ctx.restore();}}}
function breakAnnotPlugin(breaks){return{id:'ban',afterDraw(chart){const{ctx,scales:{x},chartArea:{top,bottom},data:{labels}}=chart;ctx.save();for(const{xLabel,text}of breaks){const idx=labels.indexOf(xLabel);if(idx<0)continue;const xp=x.getPixelForValue(idx);ctx.strokeStyle='rgba(251,191,36,0.55)';ctx.lineWidth=1.2;ctx.setLineDash([4,3]);ctx.beginPath();ctx.moveTo(xp,top);ctx.lineTo(xp,bottom);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='rgba(251,191,36,0.7)';ctx.font='7px JetBrains Mono,monospace';ctx.textAlign='center';ctx.fillText(text,xp,top+7);}ctx.restore();}}}

function drawUnempCharts(){
  loadCjs(()=>{
    buildUChart('iom',2006);buildUChart('ew',2006);buildUChart('jsy',2006);buildUChart('gy',2006);
  });
}

function unempRange(jur,yr){
  const prefix=`${jur}-u-r`;
  document.querySelectorAll(`[id^="${prefix}"]`).forEach(b=>b.classList.remove('active'));
  const map={iom:{2006:'iom-u-r2006',2001:'iom-u-r2001'},ew:{2006:'ew-u-r2006',1992:'ew-u-r1992'},jsy:{2006:'jsy-u-r2006',1999:'jsy-u-r1999'},gy:{2006:'gy-u-r2006',2003:'gy-u-r2003'}};
  const bid=map[jur]&&map[jur][yr];
  if(bid&&document.getElementById(bid))document.getElementById(bid).classList.add('active');
  buildUChart(jur,yr);
  setTimeout(reportHeight,60);
}

function buildUChart(jur,fromYear){
  if(_uCharts[jur]){_uCharts[jur].destroy();delete _uCharts[jur];}

  if(jur==='iom'){
    const to=2023;const labels=monthLabelsU(fromYear,to);
    const jsaMap={};MONTHLY_JSA_RATE.forEach(d=>{if(+d.t.slice(0,4)>=fromYear)jsaMap[d.t]=d.v;});
    const jsaD=labels.map(l=>jsaMap[l]??null);
    const iloD=labels.map(l=>({'2011-05':1.746,'2016-04':1.370,'2021-05':1.557}[l]??null));
    const dLine=labels.map(l=>{const yr=+l.slice(0,4),mo=+l.slice(5,7);return mo===7?(IOM_COUNTS[yr]??null):null;});
    const dBy={};for(const[y,v]of Object.entries(IOM_COUNTS))if(+y>=fromYear)dBy[+y]=v;
    _uCharts.iom=new Chart(document.getElementById('u-iom-chart'),{type:'line',data:{labels,datasets:[
      {label:'JSA%',data:jsaD,yAxisID:'yR',borderColor:U_BLUE,borderWidth:1.5,pointRadius:0,tension:0.2,fill:false,order:2},
      {label:'ILO',data:iloD,yAxisID:'yR',borderColor:'transparent',pointRadius:labels.map(l=>({'2011-05':1,'2016-04':1,'2021-05':1}[l]?7:0)),pointBackgroundColor:U_BLUE9,pointBorderColor:U_BG,pointBorderWidth:2,showLine:false,order:0},
      {label:'Deaths',data:dLine,yAxisID:'yD',borderColor:'rgba(248,113,113,0.5)',borderWidth:1.5,pointRadius:labels.map(l=>+l.slice(5,7)===7&&IOM_COUNTS[+l.slice(0,4)]?3:0),pointBackgroundColor:U_RED,spanGaps:true,tension:0.35,fill:false,order:1}
    ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false},tooltip:{callbacks:{title:i=>i[0].label,label:ctx=>{if(ctx.datasetIndex===0&&ctx.raw!=null)return` JSA: ${ctx.raw.toFixed(2)}% pop`;if(ctx.datasetIndex===1&&ctx.raw!=null)return` ILO census: ${ctx.raw.toFixed(2)}%`;if(ctx.datasetIndex===2&&ctx.raw!=null)return` Deaths: ${ctx.raw}`;return null;},filter:i=>i.raw!=null}}},scales:commonUScales(28,7,U_RED,'Deaths (reg yr)',2.2,0.5,'rgba(96,165,250,0.8)','% of population')},plugins:[mDeathStepPlugin(dBy)]});
  }

  else if(jur==='ew'){
    const to=2024;const labels=monthLabelsU(fromYear,to);
    const ccD=labels.map(l=>EW_CC_ALL[l]??null);
    const iloD=labels.map(l=>EW_ILO_CC[l]??null);
    const dLine=labels.map(l=>{const yr=+l.slice(0,4),mo=+l.slice(5,7);return mo===7?(EW_COUNTS[yr]??null):null;});
    const dBy={};for(const[y,v]of Object.entries(EW_COUNTS))if(+y>=fromYear)dBy[+y]=v;
    const breaks=[];if(fromYear<=2013)breaks.push({xLabel:'2013-09',text:'UC'});breaks.push({xLabel:'2018-07',text:'2018'});
    const ccMax=fromYear<=2000?12:8,ccStep=fromYear<=2000?2:1;
    _uCharts.ew=new Chart(document.getElementById('u-ew-chart'),{type:'line',data:{labels,datasets:[
      {label:'CC%',data:ccD,yAxisID:'yR',borderColor:U_BLUE,borderWidth:1.5,pointRadius:0,tension:0.15,fill:false,order:2},
      {label:'ILO',data:iloD,yAxisID:'yR',borderColor:'transparent',pointRadius:labels.map(l=>EW_ILO_CC[l]?7:0),pointBackgroundColor:U_BLUE9,pointBorderColor:U_BG,pointBorderWidth:2,showLine:false,order:0},
      {label:'Deaths',data:dLine,yAxisID:'yD',borderColor:'rgba(248,113,113,0.5)',borderWidth:1.5,pointRadius:labels.map(l=>+l.slice(5,7)===7&&EW_COUNTS[+l.slice(0,4)]?3:0),pointBackgroundColor:U_RED,spanGaps:true,tension:0.3,fill:false,order:1}
    ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false},tooltip:{callbacks:{title:i=>i[0].label,label:ctx=>{if(ctx.datasetIndex===0&&ctx.raw!=null)return` Claimant: ${ctx.raw.toFixed(1)}% 16-64`;if(ctx.datasetIndex===1&&ctx.raw!=null)return` ILO census: ${ctx.raw.toFixed(1)}%`;if(ctx.datasetIndex===2&&ctx.raw!=null)return` Deaths: ${(ctx.raw||0).toLocaleString()}`;return null;},filter:i=>i.raw!=null}}},scales:commonUScales(7500,1500,U_RED,'Deaths (reg yr)',ccMax,ccStep,'rgba(96,165,250,0.8)','% of 16-64 pop')},plugins:[mDeathStepPlugin(dBy),breakAnnotPlugin(breaks)]});
  }

  else if(jur==='jsy'){
    const to=2023;const labels=qLabelsU(fromYear,to);
    const aswD=labels.map(q=>JSY_ASW[q]??null);
    const iloD=labels.map(q=>JSY_ILO_ASW[q]??null);
    const dLine=labels.map(q=>{const yr=+q.slice(0,4),qi=q.slice(5);return qi==='Q2'?(JSY_COUNTS[yr]??null):null;});
    const dBy={};for(const[y,v]of Object.entries(JSY_COUNTS))if(+y>=fromYear)dBy[+y]=v;
    _uCharts.jsy=new Chart(document.getElementById('u-jsy-chart'),{type:'line',data:{labels,datasets:[
      {label:'ASW',data:aswD,yAxisID:'yR',borderColor:'rgba(245,158,11,0.55)',borderWidth:1.5,pointRadius:0,tension:0.25,fill:false,order:2},
      {label:'ILO',data:iloD,yAxisID:'yR',borderColor:'transparent',pointRadius:labels.map(q=>JSY_ILO_ASW[q]?7:0),pointBackgroundColor:'rgba(245,158,11,0.9)',pointBorderColor:U_BG,pointBorderWidth:2,showLine:false,order:0},
      {label:'Deaths',data:dLine,yAxisID:'yD',borderColor:'rgba(248,113,113,0.5)',borderWidth:1.5,pointRadius:labels.map(q=>q.endsWith('Q2')&&JSY_COUNTS[+q.slice(0,4)]?3:0),pointBackgroundColor:U_RED,spanGaps:true,tension:0.3,fill:false,order:1}
    ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false},tooltip:{callbacks:{title:i=>i[0].label,label:ctx=>{if(ctx.datasetIndex===0&&ctx.raw!=null)return` ASW: ${ctx.raw.toLocaleString()}`;if(ctx.datasetIndex===1&&ctx.raw!=null)return` ILO census: ${ctx.raw.toLocaleString()}`;if(ctx.datasetIndex===2&&ctx.raw!=null)return` Deaths: ${ctx.raw}`;return null;},filter:i=>i.raw!=null}}},scales:{x:{ticks:{color:U_TICK,font:{size:8},maxRotation:0,autoSkip:true,maxTicksLimit:12,callback(v){const l=this.getLabelForValue(v);return l&&l.endsWith('Q1')?l.slice(0,4):''}},grid:{color:U_GRID},border:{color:U_GRID}},yD:{type:'linear',position:'left',min:0,max:32,ticks:{color:U_RED,font:{size:8},stepSize:8},grid:{color:U_GRID},border:{color:'rgba(248,113,113,0.3)'},title:{display:true,text:'Deaths (reg yr)',color:U_RED,font:{size:7}}},yR:{type:'linear',position:'right',min:0,max:2800,ticks:{color:'rgba(245,158,11,0.85)',font:{size:8},stepSize:700,callback:v=>v.toLocaleString()},grid:{display:false},border:{color:'rgba(245,158,11,0.3)'},title:{display:true,text:'Registered ASW (count)',color:'rgba(245,158,11,0.85)',font:{size:7}}}}},plugins:[qDeathStepPlugin(dBy,true)]});
  }

  else if(jur==='gy'){
    const to=2024;const labels=qLabelsU(fromYear,to);
    const uD=labels.map(q=>GY_UNEMP_Q[q]??null);
    const iloD=labels.map(q=>GY_ILO_Q[q]??null);
    const dLine=labels.map(q=>{const yr=+q.slice(0,4),qi=q.slice(5);return qi==='Q2'?(GY_COUNT_AVG[yr]??null):null;});
    const dBy={};for(const[y,v]of Object.entries(GY_COUNT_AVG))if(+y>=fromYear)dBy[+y]=v;
    _uCharts.gy=new Chart(document.getElementById('u-gy-chart'),{type:'line',data:{labels,datasets:[
      {label:'Unemployed%',data:uD,yAxisID:'yR',borderColor:'rgba(96,165,250,0.6)',borderWidth:1.5,pointRadius:0,tension:0.2,fill:false,order:2},
      {label:'ILO',data:iloD,yAxisID:'yR',borderColor:'transparent',pointRadius:labels.map(q=>GY_ILO_Q[q]?7:0),pointBackgroundColor:U_BLUE9,pointBorderColor:U_BG,pointBorderWidth:2,showLine:false,order:0},
      {label:'3yr avg',data:dLine,yAxisID:'yD',borderColor:'rgba(248,113,113,0.6)',borderWidth:2,pointRadius:labels.map(q=>q.endsWith('Q2')&&GY_COUNT_AVG[+q.slice(0,4)]?4:0),pointBackgroundColor:U_RED,spanGaps:true,tension:0.4,fill:false,order:1}
    ]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:false},tooltip:{callbacks:{title:i=>i[0].label,label:ctx=>{if(ctx.datasetIndex===0&&ctx.raw!=null)return` Unemployed: ${ctx.raw.toFixed(1)}% workforce`;if(ctx.datasetIndex===1&&ctx.raw!=null)return` ILO census: ${ctx.raw.toFixed(1)}%`;if(ctx.datasetIndex===2&&ctx.raw!=null)return` 3yr avg: ${ctx.raw}/yr`;return null;},filter:i=>i.raw!=null}}},scales:{x:{ticks:{color:U_TICK,font:{size:8},maxRotation:0,autoSkip:true,maxTicksLimit:12,callback(v){const l=this.getLabelForValue(v);return l&&l.endsWith('Q1')?l.slice(0,4):''}},grid:{color:U_GRID},border:{color:U_GRID}},yD:{type:'linear',position:'left',min:0,max:12,ticks:{color:U_RED,font:{size:8},stepSize:3},grid:{color:U_GRID},border:{color:'rgba(248,113,113,0.3)'},title:{display:true,text:'3yr avg deaths/yr',color:U_RED,font:{size:7}}},yR:{type:'linear',position:'right',min:0,max:4,ticks:{color:'rgba(96,165,250,0.8)',font:{size:8},stepSize:1,callback:v=>v.toFixed(1)+'%'},grid:{display:false},border:{color:'rgba(96,165,250,0.25)'},title:{display:true,text:'% workforce wholly unemployed',color:'rgba(96,165,250,0.8)',font:{size:7}}}}},plugins:[qDeathStepPlugin(dBy,false)]});
  }
}

// ── END UNEMPLOYMENT OVERLAY ──────────────────────────────────────────────────
let _ready = false;
function safeInit() {
  if (_ready) return;
  const wrap = document.getElementById('chart-wrap');
  if ((wrap.offsetWidth || wrap.clientWidth) < 50) return;
  _ready = true;
  resize(); draw();
  setTimeout(reportHeight, 80);
}
const _poll = setInterval(() => { if (_ready) { clearInterval(_poll); return; } safeInit(); }, 40);
window.addEventListener('load', () => { safeInit(); setTimeout(safeInit, 250); setTimeout(() => { if (!_ready) { _ready=true; resize(); draw(); setTimeout(reportHeight,80); } }, 800); });
</script>
