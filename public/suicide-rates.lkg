// ── CANVAS SETUP ──────────────────────────────────────────────────────────────
const canvas = document.getElementById('chart');
const ctx = canvas.getContext('2d');
const W = 900, H = 440;
canvas.width = W; canvas.height = H;

const PAD = {top:44, right:90, bottom:52, left:58};
let XMIN = 2006, XMAX = 2024;

function CW() { return W - PAD.left - PAD.right; }
function CH() { return H - PAD.top - PAD.bottom; }

// ── THEME ─────────────────────────────────────────────────────────────────────
function tc(name) {
  const v = getComputedStyle(document.body).getPropertyValue(name).trim();
  const fallbacks = {
    '--cvs':'#0f172a','--grid':'#1e293b','--tick':'#64748b',
    '--muted':'#94a3b8','--c-ew':'#60a5fa','--c-iom':'#f87171','--c-gy':'#10b981','--c-jsy':'#f59e0b'
  };
  return v || fallbacks[name] || '#64748b';
}
function T() {
  return {
    cvs:tc('--cvs'), grid:tc('--grid'), axis:tc('--axis'), tick:tc('--tick'),
    muted:tc('--muted'), ew:tc('--c-ew'), iom:tc('--c-iom'), gy:tc('--c-gy'), jsy:tc('--c-jsy'),
  };
}

// ── STATE ─────────────────────────────────────────────────────────────────────
let currentView = 'asmr'; // 'counts' | 'crude' | 'asmr'
let vis = { ew:true, iom:true, gy:true, jsy:true };

// ── HELPERS ──────────────────────────────────────────────────────────────────
function xP(yr) { return PAD.left + ((yr - XMIN) / (XMAX - XMIN)) * CW(); }
function yP(v, ymin, ymax) { return PAD.top + (1 - (v - ymin) / (ymax - ymin)) * CH(); }

function getRange() {
  // In counts view, E&W is on a SECONDARY (right) axis — exclude it from left axis range.
  // Left axis always covers only Crown Dependencies.
  let vals = [];
  const yrs = range(XMIN, XMAX);
  if (currentView === 'counts') {
    if (vis.iom) yrs.forEach(y => { if (IOM_COUNTS[y]) vals.push(IOM_COUNTS[y]); });
    if (vis.gy)  yrs.forEach(y => { if (GY_COUNT_AVG[y]) vals.push(GY_COUNT_AVG[y]); });
    if (vis.jsy) yrs.forEach(y => { if (JSY_COUNTS[y]) vals.push(JSY_COUNTS[y]); });
    // E&W intentionally excluded — it uses its own right axis
  } else if (currentView === 'crude') {
    if (vis.ew)  yrs.forEach(y => { if (EW_COUNTS[y] && EW_POP[y]) vals.push(EW_COUNTS[y]/(EW_POP[y]*1e6)*1e5); });
    if (vis.iom) yrs.forEach(y => { if (IOM_COUNTS[y]) vals.push(IOM_COUNTS[y]/IOM_POP*1e5); });
    if (vis.jsy) yrs.forEach(y => { if (JSY_COUNTS[y]) vals.push(JSY_COUNTS[y]/JSY_POP*1e5); });
    // Guernsey not shown on crude (no annual counts)
  } else {
    if (vis.ew)  Object.values({...EW_PRE,...EW_POST}).forEach(v => { if (range(XMIN,XMAX).some(y => ({...EW_PRE,...EW_POST})[y]===v)) vals.push(v); });
    if (vis.iom) Object.values(IOM_ASMR).forEach(v => vals.push(v));
    if (vis.gy)  Object.values(GY_ASMR).forEach(v => vals.push(v));
    if (vis.jsy) Object.values(JSY_ASMR).forEach(v => vals.push(v));
    // recalculate properly
    vals = [];
    const ewAll = {...EW_PRE,...EW_POST};
    yrs.forEach(y => {
      if (vis.ew && ewAll[y])   vals.push(ewAll[y]);
      if (vis.iom && IOM_ASMR[y]) vals.push(IOM_ASMR[y]);
      if (vis.gy && GY_ASMR[y])  vals.push(GY_ASMR[y]);
      if (vis.jsy && JSY_ASMR[y]) vals.push(JSY_ASMR[y]);
    });
  }
  if (!vals.length) return [0, currentView === 'counts' ? 35 : 30];
  const mx = Math.max(...vals);
  return [0, Math.ceil(mx * 1.15 / 5) * 5];
}

function range(a, b) { const r=[]; for(let i=a;i<=b;i++) r.push(i); return r; }

// ── DRAW ──────────────────────────────────────────────────────────────────────
function draw() {
  const t = T();
  const [YMIN, YMAX] = getRange();
  const yp = v => yP(v, YMIN, YMAX);

  ctx.fillStyle = t.cvs;
  ctx.fillRect(0, 0, W, H);

  // Grid
  const gridSteps = 6;
  for (let i = 0; i <= gridSteps; i++) {
    const v = YMIN + (YMAX - YMIN) * i / gridSteps;
    const y = yp(v);
    ctx.strokeStyle = t.grid; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + CW(), y); ctx.stroke();
    ctx.fillStyle = t.tick; ctx.font = '10px "JetBrains Mono"'; ctx.textAlign = 'right';
    ctx.fillText(Math.round(v), PAD.left - 6, y + 3);
  }

  // X axis labels
  const yrs = range(XMIN, XMAX);
  const step = Math.max(1, Math.floor((XMAX - XMIN) / 10));
  ctx.fillStyle = t.tick; ctx.font = '10px "JetBrains Mono"'; ctx.textAlign = 'center';
  yrs.forEach((y,i) => {
    if ((y - XMIN) % step !== 0) return;
    ctx.fillText(y, xP(y), PAD.top + CH() + 18);
  });

  // 2018 break line (E&W standard of proof change) — ASMR view only
  if (currentView === 'asmr' && vis.ew && XMIN <= 2018 && XMAX >= 2018) {
    ctx.strokeStyle = 'rgba(96,165,250,0.3)'; ctx.lineWidth = 1; ctx.setLineDash([4,4]);
    ctx.beginPath(); ctx.moveTo(xP(2018), PAD.top); ctx.lineTo(xP(2018), PAD.top + CH()); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(96,165,250,0.5)'; ctx.font = '9px Inter'; ctx.textAlign = 'center';
    ctx.fillText('⚠ 2018 E&W', xP(2018), PAD.top - 6);
    ctx.fillText('proof change', xP(2018), PAD.top + 4);
  }

  // Axis labels
  ctx.fillStyle = t.muted; ctx.font = '10px Inter'; ctx.textAlign = 'center';
  const yLabel = currentView === 'counts' ? 'Deaths (registrations)' : 'Rate per 100,000 population';
  ctx.save(); ctx.translate(14, PAD.top + CH()/2); ctx.rotate(-Math.PI/2);
  ctx.fillText(yLabel, 0, 0); ctx.restore();

  // Title
  ctx.fillStyle = t.muted; ctx.font = '11px Inter'; ctx.textAlign = 'left';
  const viewLabel = currentView === 'counts' ? 'Annual registered deaths'
    : currentView === 'crude' ? 'Crude rate per 100,000 (annual)'
    : '3-year rolling ASMR per 100,000 (2013 ESP)';
  ctx.fillText(viewLabel, PAD.left, PAD.top - 18);

  // ── DRAW SERIES ──
  if (currentView === 'counts') drawCounts(t, yp, YMAX);
  else if (currentView === 'crude') drawCrude(t, yp);
  else drawASMR(t, yp);

  updateLegend();
}

function drawLine(data, color, yp, dashed=false, dotRadius=3, hollow=false) {
  const yrs = Object.keys(data).map(Number).filter(y => y >= XMIN && y <= XMAX).sort((a,b)=>a-b);
  if (!yrs.length) return;
  ctx.strokeStyle = color; ctx.lineWidth = 2;
  if (dashed) ctx.setLineDash([5,4]); else ctx.setLineDash([]);
  ctx.beginPath();
  yrs.forEach((y,i) => {
    const x = xP(y), yy = yp(data[y]);
    i === 0 ? ctx.moveTo(x,yy) : ctx.lineTo(x,yy);
  });
  ctx.stroke(); ctx.setLineDash([]);
  // Dots
  yrs.forEach(y => {
    const x = xP(y), yy = yp(data[y]);
    ctx.beginPath(); ctx.arc(x, yy, dotRadius, 0, Math.PI*2);
    if (hollow) { ctx.strokeStyle = color; ctx.lineWidth = 1.5; ctx.stroke(); }
    else { ctx.fillStyle = color; ctx.fill(); }
  });
}

function drawCounts(t, yp, YMAX) {
  // Left axis: IoM, Jersey, Guernsey (0–30 range)
  if (vis.iom) drawLine(IOM_COUNTS, t.iom, yp, false, 3.5);
  if (vis.jsy) drawLine(JSY_COUNTS, t.jsy, yp, false, 3.5);
  // Guernsey — 3yr avg bars
  if (vis.gy) {
    Object.entries(GY_COUNT_AVG).forEach(([yr, v]) => {
      const y = +yr;
      if (y < XMIN || y > XMAX) return;
      const x = xP(y); const yy = yp(v); const barW = Math.max(4, CW()/(XMAX-XMIN)*0.5);
      ctx.fillStyle = t.gy + '55';
      ctx.fillRect(x - barW/2, yy, barW, yp(0) - yy);
      ctx.strokeStyle = t.gy; ctx.lineWidth = 1;
      ctx.strokeRect(x - barW/2, yy, barW, yp(0) - yy);
    });
  }

  // E&W — secondary (right) axis, scaled to thousands
  if (vis.ew) {
    // Build E&W data in range
    const ewYrs = Object.keys(EW_COUNTS).map(Number).filter(y => y >= XMIN && y <= XMAX).sort((a,b)=>a-b);
    if (!ewYrs.length) return;
    const ewVals = ewYrs.map(y => EW_COUNTS[y]);
    const ewMax = Math.ceil(Math.max(...ewVals) * 1.15 / 500) * 500; // round to 500s
    const ewMin = 0;
    // Right axis y-position function
    const ypEW = v => PAD.top + (1 - (v - ewMin) / (ewMax - ewMin)) * CH();
    const rightX = PAD.left + CW();

    // Draw secondary axis ticks and labels on the right
    const ewSteps = 6;
    ctx.fillStyle = t.ew + 'cc'; ctx.font = '9px "JetBrains Mono"'; ctx.textAlign = 'left';
    for (let i = 0; i <= ewSteps; i++) {
      const v = ewMin + (ewMax - ewMin) * i / ewSteps;
      const y = ypEW(v);
      ctx.strokeStyle = t.ew + '22'; ctx.lineWidth = 0.5;
      ctx.setLineDash([2,4]);
      ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(rightX, y); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = t.ew + 'bb';
      ctx.fillText(Math.round(v).toLocaleString(), rightX + 4, y + 3);
    }

    // Right axis label
    ctx.save();
    ctx.fillStyle = t.ew + 'cc'; ctx.font = '10px Inter'; ctx.textAlign = 'center';
    ctx.translate(W - 10, PAD.top + CH()/2); ctx.rotate(-Math.PI/2);
    ctx.fillText('E&W deaths (right axis)', 0, 0);
    ctx.restore();

    // Draw E&W line against secondary axis
    ctx.strokeStyle = t.ew; ctx.lineWidth = 2; ctx.setLineDash([]);
    ctx.beginPath();
    ewYrs.forEach((y, i) => {
      const x = xP(y), yy = ypEW(EW_COUNTS[y]);
      i === 0 ? ctx.moveTo(x, yy) : ctx.lineTo(x, yy);
    });
    ctx.stroke();
    // Dots
    ewYrs.forEach(y => {
      ctx.beginPath(); ctx.arc(xP(y), ypEW(EW_COUNTS[y]), 3, 0, Math.PI*2);
      ctx.fillStyle = t.ew; ctx.fill();
    });

    // 2018 break on counts view too
    if (XMIN <= 2018 && XMAX >= 2018) {
      ctx.strokeStyle = 'rgba(96,165,250,0.3)'; ctx.lineWidth = 1; ctx.setLineDash([4,4]);
      ctx.beginPath(); ctx.moveTo(xP(2018), PAD.top); ctx.lineTo(xP(2018), PAD.top + CH()); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(96,165,250,0.5)'; ctx.font = '9px Inter'; ctx.textAlign = 'center';
      ctx.fillText('⚠ 2018', xP(2018), PAD.top - 6);
    }
  }
}

function drawCrude(t, yp) {
  if (vis.ew) {
    const ewCrude = {};
    Object.entries(EW_COUNTS).forEach(([y,c]) => {
      if (EW_POP[+y]) ewCrude[+y] = c / (EW_POP[+y] * 1e6) * 1e5;
    });
    // Split at 2018 break
    const pre = {}, post = {};
    Object.entries(ewCrude).forEach(([y,v]) => { if (+y<=2017) pre[+y]=v; else post[+y]=v; });
    drawLine(pre, t.ew, yp, false, 3);
    drawLine(post, t.ew, yp, true, 3);
  }
  if (vis.iom) {
    const iomCrude = {};
    Object.entries(IOM_COUNTS).forEach(([y,c]) => { iomCrude[+y] = c/IOM_POP*1e5; });
    drawLine(iomCrude, t.iom, yp, false, 3.5);
  }
  if (vis.jsy) {
    const jsyCrude = {};
    Object.entries(JSY_COUNTS).forEach(([y,c]) => { jsyCrude[+y] = c/JSY_POP*1e5; });
    drawLine(jsyCrude, t.jsy, yp, false, 3.5);
  }
  if (vis.gy) {
    ctx.fillStyle = t.gy+'aa'; ctx.font='10px Inter'; ctx.textAlign='left';
    ctx.fillText('Guernsey: annual counts not published — crude rate not available. Use ASMR view.', PAD.left+2, PAD.top+14);
  }
}

function drawASMR(t, yp) {
  const ewAll = {...EW_PRE, ...EW_POST};
  if (vis.ew) {
    const pre = {}, post = {};
    Object.entries(EW_PRE).forEach(([y,v]) => { if(+y>=XMIN) pre[+y]=v; });
    Object.entries(EW_POST).forEach(([y,v]) => { if(+y<=XMAX) post[+y]=v; });
    if (Object.keys(pre).length) drawLine(pre, t.ew, yp, false, 3);
    if (Object.keys(post).length) drawLine(post, t.ew, yp, true, 3);
  }
  if (vis.iom) {
    const conf={}, unconf={};
    Object.entries(IOM_ASMR).forEach(([y,v]) => {
      if (+y<XMIN||+y>XMAX) return;
      IOM_ASMR_CONF.has(+y) ? conf[+y]=v : unconf[+y]=v;
    });
    // Draw full line then overlay dots
    drawLine(IOM_ASMR, t.iom, yp, false, 3, false);
    // Hollow dots for unconfirmed
    Object.entries(unconf).forEach(([y,v]) => {
      const x=xP(+y), yy=yp(v);
      ctx.beginPath(); ctx.arc(x,yy,4,0,Math.PI*2);
      ctx.strokeStyle=t.iom; ctx.lineWidth=1.5; ctx.stroke();
      ctx.fillStyle=tc('--cvs'); ctx.fill();
    });
  }
  if (vis.gy) {
    drawLine(GY_ASMR, t.gy, yp, false, 4);
    // Error bar for 2022 (open inquest range)
    if (GY_ASMR_MAX[2022] && 2022 >= XMIN && 2022 <= XMAX) {
      const x = xP(2022);
      const y1 = yp(GY_ASMR[2022]), y2 = yp(GY_ASMR_MAX[2022]);
      ctx.strokeStyle = t.gy; ctx.lineWidth = 1.5; ctx.setLineDash([3,3]);
      ctx.beginPath(); ctx.moveTo(x,y1); ctx.lineTo(x,y2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.beginPath(); ctx.moveTo(x-5,y2); ctx.lineTo(x+5,y2); ctx.stroke();
    }
    // Hollow for non-confirmed
    Object.entries(GY_ASMR).forEach(([y,v]) => {
      if(+y<XMIN||+y>XMAX) return;
      if (!GY_ASMR_CONF.has(+y)) {
        const x=xP(+y), yy=yp(v);
        ctx.beginPath(); ctx.arc(x,yy,4,0,Math.PI*2);
        ctx.strokeStyle=t.gy; ctx.lineWidth=1.5; ctx.stroke();
        ctx.fillStyle=tc('--cvs'); ctx.fill();
      }
    });
  }
  if (vis.jsy) drawLine(JSY_ASMR, t.jsy, yp, false, 3.5);
}

function updateLegend() {
  const t = T();
  const lb = document.getElementById('legend-bar');
  const items = [];

  if (currentView === 'counts') {
    if (vis.iom) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.iom};border-radius:2px;"></span> IoM annual count (left axis)</div>`);
    if (vis.jsy) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.jsy};border-radius:2px;"></span> Jersey annual count (left axis)</div>`);
    if (vis.gy)  items.push(`<div class="leg"><span style="display:inline-block;width:14px;height:14px;background:${t.gy}55;border:1px solid ${t.gy};vertical-align:middle;"></span> Guernsey 3yr avg count (left axis — not individual years)</div>`);
    if (vis.ew)  items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.ew};border-radius:2px;"></span> E&amp;W annual count (right axis — thousands)</div>`);
  } else if (currentView === 'crude') {
    if (vis.ew)  items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.ew};border-radius:2px;"></span> E&amp;W (pre-2018 solid · post-2018 dashed — proof change)</div>`);
    if (vis.iom) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.iom};border-radius:2px;"></span> IoM crude rate</div>`);
    if (vis.jsy) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.jsy};border-radius:2px;"></span> Jersey crude rate</div>`);
    if (vis.gy)  items.push(`<div class="leg" style="color:${t.gy}aa;">Guernsey: not available (annual counts not published)</div>`);
  } else {
    if (vis.ew)  items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.ew};border-radius:2px;"></span> E&amp;W ASMR (annual · dashed post-2018)</div>`);
    if (vis.iom) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.iom};border-radius:2px;"></span> IoM 3yr ASMR (● confirmed · ○ read from chart ±1-2)</div>`);
    if (vis.gy)  items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.gy};border-radius:2px;"></span> Guernsey 3yr ASMR (● confirmed · ○ from chart · error bar = inquest range)</div>`);
    if (vis.jsy) items.push(`<div class="leg"><span style="display:inline-block;width:24px;height:3px;background:${t.jsy};border-radius:2px;"></span> Jersey 3yr ASMR</div>`);
  }
  lb.innerHTML = items.join('');
}

// ── TOOLTIP ───────────────────────────────────────────────────────────────────
let rect = canvas.getBoundingClientRect();
canvas.addEventListener('mousemove', e => {
  rect = canvas.getBoundingClientRect();
  const scaleX = W / rect.width;
  const mx = (e.clientX - rect.left) * scaleX;
  const yr = Math.round(XMIN + (mx - PAD.left) / CW() * (XMAX - XMIN));
  if (yr < XMIN || yr > XMAX) { document.getElementById('tooltip').style.display='none'; return; }

  const t = T();
  const rows = [];
  const [YMIN,YMAX] = getRange();

  if (currentView === 'counts') {
    if (vis.iom && IOM_COUNTS[yr]) rows.push({color:t.iom, label:'Isle of Man', v:`${IOM_COUNTS[yr]} deaths`, note:'annual registrations'});
    if (vis.jsy && JSY_COUNTS[yr]) rows.push({color:t.jsy, label:'Jersey', v:`${JSY_COUNTS[yr]} deaths`, note:'annual registrations'});
    if (vis.gy && GY_COUNT_AVG[yr]) rows.push({color:t.gy, label:'Guernsey', v:`~${GY_COUNT_AVG[yr]}/yr`, note:'3yr rolling average — not individual year'});
    if (vis.ew && EW_COUNTS[yr]) rows.push({color:t.ew, label:'England & Wales', v:`${EW_COUNTS[yr].toLocaleString()} deaths`, note:'right axis (thousands)'});
  } else if (currentView === 'crude') {
    if (vis.ew && EW_COUNTS[yr] && EW_POP[yr]) rows.push({color:t.ew, label:'E&W', v:`${(EW_COUNTS[yr]/(EW_POP[yr]*1e6)*1e5).toFixed(1)}/100k`, note: yr>=2018 ? 'post-2018 civil standard' : 'pre-2018 criminal standard'});
    if (vis.iom && IOM_COUNTS[yr]) rows.push({color:t.iom, label:'Isle of Man', v:`${(IOM_COUNTS[yr]/IOM_POP*1e5).toFixed(1)}/100k`, note:'year of registration'});
    if (vis.jsy && JSY_COUNTS[yr]) rows.push({color:t.jsy, label:'Jersey', v:`${(JSY_COUNTS[yr]/JSY_POP*1e5).toFixed(1)}/100k`, note:'year of registration'});
  } else {
    const ewAll = {...EW_PRE,...EW_POST};
    if (vis.ew && ewAll[yr]) rows.push({color:t.ew, label:'E&W', v:`${ewAll[yr].toFixed(1)}/100k`, note: yr>=2018 ? 'civil std' : 'criminal std'});
    if (vis.iom && IOM_ASMR[yr]) rows.push({color:t.iom, label:`IoM (${IOM_ASMR[yr-1]||'?'}–${yr+1} window)`, v:`${IOM_ASMR[yr].toFixed(1)}/100k`, note: IOM_ASMR_CONF.has(yr) ? 'confirmed' : 'read from chart ±1-2'});
    if (vis.gy && GY_ASMR[yr]) rows.push({color:t.gy, label:'Guernsey', v:`${GY_ASMR[yr].toFixed(1)}/100k${GY_ASMR_MAX[yr]?' – '+GY_ASMR_MAX[yr]+' max':''}`, note: GY_ASMR_CONF.has(yr) ? 'confirmed' : 'from published chart'});
    if (vis.jsy && JSY_ASMR[yr]) rows.push({color:t.jsy, label:'Jersey', v:`${JSY_ASMR[yr].toFixed(1)}/100k`, note:'3yr rolling'});
  }

  if (!rows.length) { document.getElementById('tooltip').style.display='none'; return; }

  document.getElementById('t-year').textContent = yr;
  document.getElementById('t-rows').innerHTML = rows.map(r =>
    `<div class="t-row"><span class="t-dot" style="background:${r.color}"></span><div><span class="t-val">${r.label}: ${r.v}</span><br><span class="t-note">${r.note}</span></div></div>`
  ).join('');

  const tip = document.getElementById('tooltip');
  tip.style.display = 'block';
  const sw = tip.offsetWidth;
  const relX = (xP(yr)/W) * rect.width;
  tip.style.left = (relX + sw + 16 > rect.width ? relX - sw - 8 : relX + 12) + 'px';
  tip.style.top = '50px';
});
canvas.addEventListener('mouseleave', () => { document.getElementById('tooltip').style.display='none'; });

// ── VIEW TABS ─────────────────────────────────────────────────────────────────
['counts','crude','asmr'].forEach(v => {
  document.getElementById(`tab-${v}`).addEventListener('click', () => {
    currentView = v;
    document.querySelectorAll('.view-tab[id^="tab-"]').forEach(b => b.classList.remove('active'));
    document.getElementById(`tab-${v}`).classList.add('active');
    draw();
  });
});

document.getElementById('range-all').addEventListener('click', () => {
  XMIN=1981; XMAX=2024;
  document.getElementById('range-all').classList.add('active');
  document.getElementById('range-2006').classList.remove('active');
  draw();
});
document.getElementById('range-2006').addEventListener('click', () => {
  XMIN=2006; XMAX=2024;
  document.getElementById('range-2006').classList.add('active');
  document.getElementById('range-all').classList.remove('active');
  draw();
});

// ── SERIES TOGGLES ────────────────────────────────────────────────────────────
const COLORS = { ew:'--c-ew', iom:'--c-iom', gy:'--c-gy', jsy:'--c-jsy' };
['ew','iom','gy','jsy'].forEach(k => {
  document.getElementById(`btn-${k}`).addEventListener('click', () => {
    vis[k] = !vis[k];
    const col = tc(COLORS[k]);
    const btn = document.getElementById(`btn-${k}`);
    btn.style.background = vis[k] ? col : 'transparent';
    btn.style.color = vis[k] ? tc('--cvs') : col;
    btn.style.borderColor = col;
    draw();
  });
});

// ── NOTES TOGGLE ──────────────────────────────────────────────────────────────
document.getElementById('notes-toggle').addEventListener('click', () => {
  const body = document.getElementById('notes-body');
  const hint = document.getElementById('hint-text');
  const open = body.style.display !== 'none';
  body.style.display = open ? 'none' : 'block';
  hint.textContent = open ? '▼ Click to expand' : '▲ Click to collapse';
  setTimeout(reportHeight, 60);
});

// ── RESPONSIVE & IFRAME COMMS ─────────────────────────────────────────────────
function resize() {
  const wrap = document.getElementById('chart-wrap');
  const w = Math.min(wrap.offsetWidth || wrap.clientWidth || W, W);
  if (!w) return;
  canvas.style.height = Math.round(w * H / W) + 'px';
}

let _lastH = 0;
function reportHeight() {
  resize();
  const h = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
  if (Math.abs(h - _lastH) < 4) return;
  _lastH = h;
  try { window.parent.postMessage({ type:'resize', height: h + 24 }, '*'); } catch(e) {}
}

window.addEventListener('message', e => {
  // Theme messages no longer actioned — dark-only design
  if (e.data && e.data.type === 'resize') return;
});

let _rTimer;
window.addEventListener('resize', () => { clearTimeout(_rTimer); _rTimer = setTimeout(() => { resize(); draw(); }, 120); });

// ── IoM DETAIL TAB ────────────────────────────────────────────────────────────
function backToComparison() {
  document.getElementById('chart-body').style.display = '';
  document.getElementById('iom-panel').style.display = 'none';
  document.getElementById('unemp-panel').style.display = 'none';
  document.getElementById('range-row').style.display = '';
  document.querySelectorAll('.view-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-asmr').classList.add('active');
  currentView = 'asmr';
  draw();
  setTimeout(reportHeight, 60);
}

document.getElementById('tab-iom').addEventListener('click', () => {
  document.getElementById('chart-body').style.display = 'none';
  document.getElementById('iom-panel').style.display = 'block';
  document.getElementById('range-row').style.display = 'none';
  document.querySelectorAll('.view-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-iom').classList.add('active');
  if (!window._iomChartsDrawn) { drawIomCharts(); window._iomChartsDrawn = true; }
  setTimeout(reportHeight, 60);
});

// Re-show chart body when other tabs clicked
['counts','crude','asmr'].forEach(v => {
  document.getElementById(`tab-${v}`).addEventListener('click', () => {
    document.getElementById('chart-body').style.display = '';
    document.getElementById('iom-panel').style.display = 'none';
    document.getElementById('range-row').style.display = '';
  });
});

function toggleIomNotes() {
  const body = document.getElementById('iom-notes-body');
  const hint = document.getElementById('iom-hint-text');
  const open = body.style.display !== 'none';
  body.style.display = open ? 'none' : 'block';
  hint.textContent = open ? '▼ Click to expand' : '▲ Click to collapse';
  setTimeout(reportHeight, 60);
}

// ── CHART.JS LOADER (global — used by both IoM demographics and labour market tabs) ──
function loadCjs(cb) {
  if (window.Chart) { cb(); return; }
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js';
  s.onload = cb; document.head.appendChild(s);
}

function drawIomCharts() {
  const gridC = 'rgba(255,255,255,0.07)';
  const tickC = 'rgba(255,255,255,0.45)';
  const MALE   = '#f87171';
  const FEMALE = 'rgba(248,113,113,0.35)';
  const JSA_C  = 'rgba(96,165,250,0.8)';

  loadCjs(() => {

    // ── SEX RATES CHART — grouped bars, all 4 jurisdictions ──────────────────
    // Average annual rate per 100k, 2019-23
    // IoM: confirmed (Constabulary FOI)
    // Jersey: confirmed counts, estimated sex split
    // Guernsey: estimated counts and sex split
    // E&W: ONS counts, ~74% male applied
    new Chart(document.getElementById('sex-rate-chart'), {
      type: 'bar',
      data: {
        labels: ['Isle of Man', 'Jersey', 'Guernsey', 'England & Wales'],
        datasets: [
          { label: 'Male',
            data: [23.8, 11.1, 19.6, 13.8],
            backgroundColor: MALE,
            borderRadius: 3 },
          { label: 'Female',
            data: [7.4, 4.3, 6.0, 4.8],
            backgroundColor: FEMALE,
            borderColor: MALE, borderWidth: 1,
            borderRadius: 3 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: {
            label: ctx => ` ${ctx.dataset.label}: ${ctx.raw}/100k/yr`
              + (ctx.dataIndex > 0 ? (ctx.dataIndex === 3 ? '' : ' (est.)') : '')
          }}
        },
        scales: {
          x: { ticks:{color:tickC,font:{size:11}}, grid:{display:false}, border:{color:gridC} },
          y: { min:0, max:30,
            ticks:{color:tickC,font:{size:10},callback:v=>v+'/100k'},
            grid:{color:gridC}, border:{color:gridC},
            title:{display:true,text:'avg annual deaths per 100,000',color:tickC,font:{size:9}}
          }
        }
      },
      plugins: [{
        id: 'estMarkers',
        afterDraw(chart) {
          // Mark Jersey and Guernsey bars with "est." label
          const {ctx, scales:{x,y}} = chart;
          ctx.save();
          ctx.fillStyle = 'rgba(96,165,250,0.6)';
          ctx.font = '8px Inter,sans-serif';
          ctx.textAlign = 'center';
          [1,2].forEach(idx => {
            const xPx = x.getPixelForValue(idx);
            ctx.fillText('est.', xPx, y.getPixelForValue(0) + 10);
          });
          ctx.restore();
        }
      }]
    });


    // ── COMBINED OVERLAY: deaths (annual) + JSA monthly rate + census ILO ────
    const oLabels = MONTHLY_JSA_RATE.map(d => d.t);

    // Map annual death counts to their mid-year month for positioning
    // Deaths plotted as step annotations spanning the full year
    const deathsByYear = {};
    Object.entries(IOM_COUNTS).forEach(([y,c]) => { deathsByYear[+y] = c; });

    // Build a sparse dataset: one point per year at July (mid-year)
    const deathPoints = oLabels.map(t => {
      const y = +t.slice(0,4);
      const m = +t.slice(5,7);
      return m === 7 ? (deathsByYear[y] ?? null) : null;
    });

    new Chart(document.getElementById('iom-overlay-chart'), {
      type: 'line',
      data: {
        labels: oLabels,
        datasets: [
          // JSA monthly rate — right axis
          { label: 'JSA claimant rate %',
            data: MONTHLY_JSA_RATE.map(d => d.v),
            yAxisID: 'yJ',
            borderColor: 'rgba(96,165,250,0.7)',
            borderWidth: 1.5,
            pointRadius: 0,
            tension: 0.2,
            fill: false,
            order: 2 },
          // Census ILO markers — right axis
          { label: 'Census ILO rate %',
            data: oLabels.map(t => CENSUS_ILO_RATE[t] ?? null),
            yAxisID: 'yJ',
            borderColor: 'transparent',
            pointRadius: oLabels.map(t => CENSUS_ILO_RATE[t] ? 8 : 0),
            pointBackgroundColor: 'rgba(96,165,250,0.9)',
            pointBorderColor: '#0f172a',
            pointBorderWidth: 2,
            pointStyle: 'circle',
            showLine: false,
            order: 0 },
          // Deaths — left axis, continuous line through annual mid-year points
          { label: 'Deaths (annual)',
            data: deathPoints,
            yAxisID: 'yD',
            borderColor: '#f87171',
            borderWidth: 2,
            pointRadius: oLabels.map(t => +t.slice(5,7) === 7 && deathsByYear[+t.slice(0,4)] ? 4 : 0),
            pointBackgroundColor: '#f87171',
            pointBorderColor: '#f87171',
            spanGaps: true,
            tension: 0.35,
            fill: false,
            showLine: true,
            order: 1 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              title: i => i[0].label,
              label: ctx => {
                if (ctx.datasetIndex === 0 && ctx.raw != null)
                  return ` JSA: ${ctx.raw.toFixed(2)}% of population`;
                if (ctx.datasetIndex === 1 && ctx.raw != null)
                  return ` ILO (census): ${ctx.raw.toFixed(2)}% of population`;
                return null;
              },
              filter: item => item.raw != null
            }
          }
        },
        scales: {
          x: {
            ticks: { color: tickC, font:{size:9}, maxRotation:0, autoSkip:true, maxTicksLimit:12,
              callback(val) { const l=this.getLabelForValue(val); return l&&l.endsWith('-01')?l.slice(0,4):''; }
            },
            grid: { color: gridC }, border: { color: gridC }
          },
          yJ: {
            type: 'linear', position: 'right',
            min: 0, max: 2.2,
            ticks: { color: 'rgba(96,165,250,0.8)', font:{size:10},
              callback: v => v.toFixed(1)+'%' },
            grid: { color: gridC }, border: { color: 'rgba(96,165,250,0.4)' },
            title: { display:true, text:'% of population', color:'rgba(96,165,250,0.7)', font:{size:9} }
          },
          yD: {
            type: 'linear', position: 'left',
            min: 0, max: 28,
            ticks: { color: MALE, font:{size:10}, stepSize:5 },
            grid: { display: false }, border: { color: 'rgba(248,113,113,0.4)' },
            title: { display:true, text:'Deaths (annual)', color: MALE, font:{size:9} }
          }
        }
      },
      plugins: [{
        id: 'deathBars',
        afterDraw(chart) {
          // Draw annual death counts as horizontal step lines spanning each year
          const {ctx, scales:{x, yD}} = chart;
          const labels = chart.data.labels;
          ctx.save();
          ctx.strokeStyle = 'rgba(248,113,113,0.55)';
          ctx.lineWidth = 2;
          Object.entries(deathsByYear).forEach(([yr, count]) => {
            const y = +yr;
            if (y < 2006 || y > 2023) return;
            const janLabel = `${y}-01`;
            const decLabel = `${y}-12`;
            const janIdx = labels.indexOf(janLabel);
            const decIdx = labels.indexOf(decLabel);
            if (janIdx < 0 || decIdx < 0) return;
            const x1 = x.getPixelForValue(janIdx);
            const x2 = x.getPixelForValue(decIdx);
            const yPx = yD.getPixelForValue(count);
            ctx.beginPath();
            ctx.moveTo(x1, yPx);
            ctx.lineTo(x2, yPx);
            ctx.stroke();
          });
          ctx.restore();
        }
      }]
    });

    }); // end loadCjs
} // end drawIomCharts


