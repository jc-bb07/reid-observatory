  </div>

</div><!-- /shell -->
<script>
/* Observatory theme v3 */
(function () {
  try { if (localStorage.getItem('observatory-theme') === 'light') document.body.classList.add('light'); } catch (_) {}
  window.addEventListener('message', function (e) {
    var d = e.data;
    if (d && (d.type === 'theme' || d.type === 'setTheme')) {
      document.body.classList.toggle('light', d.theme === 'light');
      // Redraw canvas-based chart so colours update with theme
      if (typeof draw === 'function') draw();
    }
  });
}());
</script>
</body>
