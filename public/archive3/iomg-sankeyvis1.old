const RAW = {"2017-18":{"cap_receipts":-60.86,"cap_payments":66.27,"cap_surplus":-5.41,"cap_balance_cf":25.73,"customs":358.68,"incometax":211.25,"other_treasury":12.02,"deptfees":119.91,"penscon":20.7,"ni_rec":241.5,"total_income":964.05,"emp":315.45,"erpension":41.95,"penrev":57.29,"nonemp":261.65,"niwelfare":246.5,"revwelfare":80.93,"cfr_old":45.37,"intfunds":19.45,"total_exp":1030.07,"surplus":2.86,"pension_gross":103.0,"pension_emp_contrib":-21.0,"pension_dept_contrib":-42.0,"pension_rev_liability":0.0,"cfr":45.37,"gdp_real_2324_prices_m":6506},"2018-19":{"cap_receipts":-62.53,"cap_payments":62.0,"cap_surplus":0.53,"cap_balance_cf":46.48,"customs":358.75,"incometax":232.9,"other_treasury":10.9,"deptfees":126.33,"penscon":27.38,"ni_rec":247.21,"total_income":1003.47,"emp":328.73,"erpension":35.39,"penrev":63.22,"nonemp":266.54,"niwelfare":245.73,"revwelfare":77.63,"cfr_old":41.74,"intfunds":10.8,"total_exp":1028.25,"surplus":23.15,"pension_gross":107.0,"pension_emp_contrib":-24.0,"pension_dept_contrib":-44.0,"pension_rev_liability":45.0,"ni_contributions":196.3,"cfr":41.74,"gdp_real_2324_prices_m":6624},"2019-20":{"cap_receipts":66.92,"cap_payments":98.43,"cap_surplus":-31.5,"cap_balance_cf":36.08,"customs":444.53,"incometax":241.12,"other_treasury":10.3,"deptfees":122.64,"penscon":30.72,"ni_rec":267.7,"total_income":1117.02,"emp":359.54,"erpension":38.13,"penrev":62.73,"nonemp":284.16,"niwelfare":251.25,"cfr_old":42.43,"intfunds":17.96,"total_exp":1089.97,"surplus":68.89,"ni_contributions":221.2,"revwelfare":74.63,"cfr":25.0,"pension_gross":100.0,"pension_emp_contrib":-31.0,"pension_dept_contrib":-38.0,"pension_rev_liability":24.0,"ni_welfare_exp":207.1,"ni_fund_cf":884.8,"gdp_real_2324_prices_m":6632},"2021-22":{"cap_receipts":67.24,"cap_payments":88.18,"cap_surplus":-20.94,"cap_balance_cf":56.87,"customs":423.42,"incometax":241.37,"other_treasury":8.76,"deptfees":118.79,"penscon":33.4,"ni_rec":306.48,"total_income":1132.22,"emp":390.15,"erpension":42.39,"penrev":71.23,"nonemp":293.18,"niwelfare":274.84,"revwelfare":76.31,"intfunds":42.29,"total_exp":1174.45,"surplus":6.82,"pension_gross":113.0,"pension_emp_contrib":-33.0,"pension_dept_contrib":-42.0,"ni_contributions":228.8,"ni_welfare_exp":211.6,"ni_fund_cf":883.4,"sinking":3.5,"cfr":25.0,"pension_rev_liability":1.0,"gdp_real_2324_prices_m":6310},"2020-21":{"cap_receipts":46.38,"cap_payments":81.22,"cap_surplus":-34.84,"customs":328.44,"incometax":234.98,"other_treasury":6.72,"deptfees":106.68,"penscon":32.67,"ni_rec":303.37,"total_income":1012.85,"emp":374.35,"erpension":39.82,"penrev":71.64,"nonemp":236.67,"niwelfare":331.83,"revwelfare":78.72,"sinking":3.5,"cfr":25.0,"intfunds":78.25,"total_exp":1221.07,"surplus":-60.43,"pension_gross":111.0,"pension_emp_contrib":-33.0,"pension_dept_contrib":-40.0,"pension_rev_liability":29.0,"ni_contributions":218.1,"ni_fund_cf":839.8,"gdp_real_2324_prices_m":6105},"2022-23":{"cap_receipts":23.6,"cap_payments":85.0,"cap_surplus":-47.82,"customs":451.93,"incometax":274.97,"other_treasury":11.76,"deptfees":134.69,"penscon":38.45,"ni_rec":306.5,"total_income":1218.3,"emp":420.82,"erpension":44.79,"penrev":75.44,"nonemp":282.87,"niwelfare":289.96,"revwelfare":85.67,"sinking":3.5,"cfr":20.0,"intfunds":58.48,"total_exp":1230.43,"surplus":38.58,"pension_gross":120.0,"pension_emp_contrib":-36.0,"pension_dept_contrib":-46.0,"pension_rev_liability":28.0,"ni_contributions":254.3,"ni_fund_cf":924.6,"gdp_real_2324_prices_m":5990},"2023-24":{"customs":441.66,"incometax":324.92,"other_treasury":16.04,"deptfees":151.47,"penscon":41.69,"ni_rec":326.31,"total_income":1302.08,"emp":460.15,"erpension":49.18,"penrev":82.24,"nonemp":325.36,"niwelfare":309.18,"revwelfare":81.98,"sinking":3.5,"cfr":48.5,"intfunds":31.73,"total_exp":1356.79,"surplus":-40.15,"pension_gross":131.0,"pension_emp_contrib":-42.0,"pension_dept_contrib":-49.0,"pension_rev_liability":40.0,"ni_contributions":268.4,"ni_fund_cf":969.4,"cap_balance_cf":28.8,"cap_receipts":4.7,"cap_payments":85.0,"gdp_real_2324_prices_m":5840},"2024-25":{"customs":521.65,"incometax":388.53,"other_treasury":5.28,"deptfees":149.76,"penscon":43.65,"ni_rec":328.46,"total_income":1437.33,"emp":491.72,"erpension":53.42,"penrev":89.87,"nonemp":343.15,"niwelfare":330.38,"revwelfare":86.47,"sinking":3.5,"cfr":64.0,"intfunds":37.85,"total_exp":1465.09,"surplus":14.4,"pension_gross":143.0,"pension_emp_contrib":-44.0,"pension_dept_contrib":-53.0,"pension_rev_liability":46.0,"ni_contributions":278.6,"ni_fund_cf":975.9,"cap_balance_cf":3.77,"cap_receipts":14.3,"cap_payments":85.0},"2025-26":{"cfr_receipts":5.18,"cfr_payments":-60.0,"cap_balance_cf":3.82,"customs":473.55,"incometax":384.04,"other_treasury":11.23,"deptfees":150.61,"penscon":39.85,"ni_rec":329.74,"total_income":1389.02,"emp":507.24,"erpension":62.63,"penrev":80.29,"nonemp":345.28,"niwelfare":353.55,"revwelfare":87.94,"sinking":3.5,"cfr":19.0,"intfunds":41.75,"total_exp":1458.05,"surplus":1.26,"pension_gross":143.0,"pension_emp_contrib":-40.0,"pension_dept_contrib":-63.0,"pension_rev_liability":40.0,"ni_contributions":273.7,"ni_fund_cf":992.5},"2026-27":{"cfr_receipts":4.5,"cfr_payments":-50.0,"cap_surplus":-67.64,"cap_balance_cf":2.64,"customs":496.22,"incometax":413.37,"other_treasury":13.36,"deptfees":151.4,"penscon":48.45,"ni_rec":347.04,"total_income":1469.84,"emp":543.4,"erpension":61.84,"penrev":98.87,"nonemp":376.25,"niwelfare":375.2,"revwelfare":95.71,"sinking":3.5,"cfr":10.0,"intfunds":43.95,"total_exp":1545.05,"surplus":1.64,"pension_gross":161.0,"pension_emp_contrib":-48.0,"pension_dept_contrib":-62.0,"pension_rev_liability":51.0,"ni_contributions":292.1,"ni_welfare_exp":287.5,"ni_fund_cf":999.4}};

const YEAR_TYPES = {"2017-18":"actuals","2018-19":"actuals","2019-20":"actuals","2020-21":"actuals","2021-22":"actuals","2022-23":"actuals","2023-24":"actuals","2024-25":"actuals","2025-26":"budget","2026-27":"budget"};

const YEARS = ["2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25","2025-26","2026-27"];

// ── Node definitions ──────────────────────────────────────────────────────────
const SOURCES = [
  {id:'customs',   name:'Customs & VAT',         color:'#4a9eff',
   note:'Calculated under FERSA — formula-derived share of UK VAT pool, indexed from 2018-19 survey. New survey underway.'},
  {id:'incometax', name:'Income tax',             color:'#3a82e0'},
  {id:'ni_rec',    name:'National Insurance',     color:'#2a65c0'},
  {id:'deptfees',  name:'Dept fees & charges',    color:'#7a5af8'},
  {id:'penscon',   name:'Pension contributions',  color:'#9b7cf4'},
  {id:'other_treasury', name:'Other receipts',   color:'#b89ef0'},
];

const USES = [
  {id:'emp',       name:'Employee costs',              color:'#2dd4a0', group:'people'},
  {id:'erpension', name:'Employer pension',            color:'#25b88a', group:'people'},
  {id:'penrev',    name:'Pension revenue liability',   color:'#1e9c74',
   note:'Annual cash cost after employee & employer contributions. Past service liability £2.9bn on balance sheet (FRS 102) but absent from fiscal headlines.', group:'people'},
  {id:'nonemp',    name:'Non-employee costs',          color:'#6aaa2a', group:'nonpeople'},
  {id:'niwelfare', name:'NI welfare',                  color:'var(--amber)', group:'welfare',
   note:'2020-21 includes ~£73m COVID schemes (Salary Support, MERA).'},
  {id:'revwelfare',name:'Revenue welfare',             color:'#e09010', group:'welfare'},
  {id:'cfr',       name:'CFR & capital transfer',      color:'#9b7cf4', group:'reserves'},
  {id:'intfunds',  name:'Internal funds',              color:'#7a5af8', group:'reserves'},
  {id:'sinking',   name:'Sinking fund',                color:'#6340e0', group:'reserves'},
];

const USE_GROUPS = [
  {label:'People costs',         ids:['emp','erpension','penrev'],  color:'#2dd4a0'},
  {label:'Non-people costs',     ids:['nonemp'],                    color:'#6aaa2a'},
  {label:'Welfare',              ids:['niwelfare','revwelfare'],    color:'var(--amber)'},
  {label:'Reserves & transfers', ids:['cfr','intfunds','sinking'],  color:'#9b7cf4'},
];


const NODE_DESC = {"customs": {"title": "Customs & VAT", "body": "The Island's largest single revenue source. Calculated under FERSA (the Final Expenditure Revenue Sharing Arrangement) \u2014 a formula-derived share of the UK VAT and shared duties pool, not a tax collected directly on the Island. The current indexation is based on a 2018-19 expenditure survey. A new survey is underway; if the Island's share has fallen since 2018-19 \u2014 consistent with the real-terms GDP contraction since 2019-20 \u2014 a retrospective adjustment payment to the UK may be required.", "source": "Table 3A \u00b7 Table 25"}, "incometax": {"title": "Income & Other Taxes", "body": "Resident income tax, company tax, and non-resident tax. The resident rate is capped at 20% with a \u00a3200,000 ceiling (the tax cap), which attracts high-net-worth individuals. Company income has declined materially since 2021-22, flowing through to this line.", "source": "Table 3A \u00b7 Table 25"}, "ni_rec": {"title": "National Insurance receipts", "body": "Employee and employer NI contributions plus agency income (collected on behalf of HMRC). This funds NI welfare payments and the NHS allocation to health services. The NI Fund balance (~\u00a3992m in 2025-26) acts as a buffer. NI welfare expenditure has grown faster than contribution income in recent years.", "source": "Table 3A \u00b7 Table 16"}, "deptfees": {"title": "Departmental fees & charges", "body": "Income earned by government departments from services \u2014 including the Aircraft Registry, Ship Registry, Central Registry, port fees, planning, and licensing charges. The registries generate significant fee income relative to their operating cost, making them net contributors to the revenue account.", "source": "Table 3A"}, "penscon": {"title": "Employee pension contributions", "body": "Salary deductions into the pension scheme. In an unfunded scheme these do not accumulate in a pot \u2014 they flow through the revenue account and offset part of the gross pension cost. The scheme has moved new entrants to defined contribution, but legacy defined benefit member contributions still appear here.", "source": "Table 3A \u00b7 Table 15"}, "other_treasury": {"title": "Other receipts", "body": "Miscellaneous Treasury income \u2014 investment income, dividends from government-owned entities, fines, and other non-tax receipts. Relatively small and variable.", "source": "Table 3A"}, "emp": {"title": "Employee costs", "body": "Gross salaries and wages of all civil servants and public sector workers \u2014 payroll in the pure sense, excluding employer NI and pension contributions (shown separately). In real terms (2024-25 prices), growth since 2017-18 is approximately 21% \u2014 significant, but substantially less than the 56% nominal figure. The largest single expenditure line.", "source": "Table 3A \u00b7 Appendix 4"}, "erpension": {"title": "Employer pension contribution", "body": "The employer's notional cash contribution to the pension scheme, charged to departments. In an unfunded defined benefit scheme this is partly a bookkeeping entry \u2014 no investment fund receives the money. For new defined contribution entrants, employer contributions are real cash flows.", "source": "Table 3A \u00b7 Table 15"}, "penrev": {"title": "Pension revenue liability", "body": "The residual pension cost after employee and employer contributions are deducted from the gross cost of the scheme. This is the direct annual charge to the revenue account. It was offset for years by the PSEPR reserve \u2014 exhausted around 2022-23 \u2014 and is now a live annual liability. Note: this is entirely separate from the estimated \u00a32bn+ £2.9bn stock of past service obligations is recorded on the government’s consolidated balance sheet under FRS 102 — it is not off balance sheet. What it is absent from is the Pink Book and all headline fiscal reporting.", "source": "Table 15"}, "nonemp": {"title": "Non-employee costs", "body": "Everything departments spend that is not people costs: premises, utilities, maintenance; supplies, services and equipment; IT infrastructure; transport; loan charges on internal borrowing; contracted and agency services; grants and subsidies. A transfer from the NI Fund to health (the NHS allocation, ~\u00a371m in 2025-26) offsets part of this block, reducing the net charge to the revenue account.", "source": "Table 3A \u00b7 Appendix 4"}, "niwelfare": {"title": "NI welfare payments", "body": "Contributory welfare benefits paid from the National Insurance Fund \u2014 state pension, incapacity, unemployment, and related NI-funded payments. Funded from NI contributions, not general taxation. The 2020-21 figure was substantially inflated by COVID-era schemes (Salary Support Scheme ~\u00a361m, MERA ~\u00a312m). The NI Fund balance provides a buffer, but welfare expenditure growth has outpaced contribution income in recent years.", "source": "Table 3A \u00b7 Table 16"}, "revwelfare": {"title": "Revenue welfare", "body": "Non-contributory welfare benefits funded from general taxation \u2014 income support, housing benefit, and other means-tested payments. Smaller than NI welfare but growing, reflecting demographic pressure and the interaction between housing costs and benefit entitlements.", "source": "Table 3A"}, "cfr": {"title": "CFR & capital transfer", "body": "Transfer to the Capital Financing Reserve, the government's mechanism for funding capital investment (roads, buildings, infrastructure) without external borrowing. Revenue surpluses are transferred in; drawdowns fund projects. In years before 2021 this line captured Capital Funding and Loan Charges under a different label. The CFR balance has been running down as capital spending outpaces transfers in.", "source": "Table 3A \u00b7 Table 2"}, "intfunds": {"title": "Internal funds", "body": "Transfers to ring-fenced departmental reserves including the Enterprise Development Fund, Medical Indemnity Fund, Housing Reserve, and similar pots. Not expenditure in the traditional sense \u2014 money set aside for specific future purposes. A corresponding transfer back from funds appears elsewhere, reducing net expenditure. The 2020-21 spike reflects COVID-related transfers.", "source": "Table 3A"}, "sinking": {"title": "Sinking fund", "body": "Annual contribution to the Bond Repayment Sinking Fund, a reserve for servicing and repaying the government's bond debt. A fixed \u00a33.5m per year \u2014 small but consistent, reflecting the IoM's limited external borrowing compared to most jurisdictions.", "source": "Table 3A"}};
const NODE_LABELS = {};
[...SOURCES,...USES].forEach(n=>NODE_LABELS[n.id]=n.name);
const NODE_NOTES = {};
[...SOURCES,...USES].forEach(n=>{if(n.note) NODE_NOTES[n.id]=n.note;});


// ── Deflators (IoM CPI, FY averages, base = 2024-25) ─────────────────────────
const DEFLATORS = {"2008-09":1.559312,"2009-10":1.526756,"2010-11":1.456617,"2011-12":1.383383,"2012-13":1.360315,"2013-14":1.340324,"2014-15":1.330547,"2015-16":1.343318,"2016-17":1.333936,"2017-18":1.284234,"2018-19":1.252817,"2019-20":1.227988,"2020-21":1.232931,"2021-22":1.17894,"2022-23":1.081041,"2023-24":1.023646,"2024-25":1.0,"2025-26":0.973436,"2026-27":0.95};
// 2026-27 deflator estimated (CPI ~+3% on 2025-26 partial year average)
const CPI_BASE_LABEL = "2024-25 prices";

let showReal = true;  // default: real terms

function realVal(year, id) {
  const nominal = getVal(year, id);
  if (!showReal) return nominal;
  const d = DEFLATORS[year] || 1.0;
  return Math.round(nominal * d * 10) / 10;
}

function deflate(year, value) {
  if (!showReal) return value;
  const d = DEFLATORS[year] || 1.0;
  return Math.round(value * d * 10) / 10;
}

// ── State ─────────────────────────────────────────────────────────────────────
let currentYear = '2025-26';
let selectedNode = null;

// ── Helpers ───────────────────────────────────────────────────────────────────
const fmt = v => v==null ? '—' : '£'+Math.abs(v).toFixed(1)+'m';
const fmtSign = v => v==null ? '—' : (v>=0?'+':'')+v.toFixed(1)+'%';

function getVal(year, id) {
  const d = RAW[year];
  if(!d) return 0;
  return d[id] || 0;
}

// ── Controls ──────────────────────────────────────────────────────────────────

function buildModeControls() {
  const el = document.getElementById('mode-controls');
  el.innerHTML = '';

  // Nominal/Real toggle
  const nr = document.createElement('button');
  nr.className = 'year-pill' + (showReal ? ' active' : '');
  nr.innerHTML = showReal
    ? `Real terms <span class="badge">${CPI_BASE_LABEL}</span>`
    : `Nominal <span class="badge">as published</span>`;
  nr.title = showReal ? 'Showing inflation-adjusted values. Click for nominal.' : 'Showing nominal values. Click for real terms.';
  nr.onclick = () => {
    showReal = !showReal;
    buildModeControls();
    drawSankey();
    updateStocks();
    if (selectedNode) drawTS(selectedNode);
  };
  el.appendChild(nr);

  // Label
  const lbl = document.createElement('span');
  lbl.style.cssText = 'font-size:10.5px;color:var(--text-muted);padding:0 6px';
  lbl.textContent = showReal
    ? `IoM CPI-adjusted · Source: Statistics IoM Dec 2025`
    : 'Values as published in Pink Books';
  el.appendChild(lbl);
}

function buildControls() {
  const el = document.getElementById('year-controls');
  el.innerHTML = '';
  YEARS.forEach(y => {
    const b = document.createElement('button');
    b.className = 'year-pill' + (y===currentYear?' active':'');
    const type = YEAR_TYPES[y];
    b.innerHTML = y + `<span class="badge">${type==='actuals'?'act':type==='budget'?'bgt':'prov'}</span>`;
    b.onclick = () => { currentYear=y; buildControls(); drawSankey(); updateStocks(); };
    el.appendChild(b);
  });
}

// ── Legend ────────────────────────────────────────────────────────────────────
function buildLegend() {
  const el = document.getElementById('legend');
  USE_GROUPS.forEach(g => {
    el.innerHTML += `<div class="leg-item"><div class="leg-dot" style="background:${g.color}"></div>${g.label}</div>`;
  });
  el.innerHTML += `<div class="leg-item" style="margin-left:.5rem"><div class="leg-dot" style="background:#4a9eff"></div>Revenue source</div>`;
}

// ── Sankey ────────────────────────────────────────────────────────────────────
function drawSankey() {
  const svg = d3.select('#sankey-svg');
  svg.selectAll('*').remove();

  const W=960, H=520, NODE_W=14, GAP=6, SRC_X=180, USE_X=740, LP=10, TOP=30;

  const srcNodes = SOURCES.map(s => ({...s, v: realVal(currentYear, s.id)||0}));
  const useNodes = USES.map(u => ({...u, v: realVal(currentYear, u.id)||0})).filter(u => u.v > 0);

  const totalSrc = d3.sum(srcNodes, d=>d.v);
  const totalUse = d3.sum(useNodes, d=>d.v);

  const drawH = H - TOP - 20;
  function layoutNodes(nodes, x) {
    const total = d3.sum(nodes, n=>n.v);
    const usable = drawH - (nodes.length-1)*GAP;
    const sc = usable/total;
    let y = TOP + (drawH - (usable + (nodes.length-1)*GAP))/2;
    return nodes.map(n => {
      const h = Math.max(n.v*sc, 2);
      const node = {...n, x, y, h};
      y += h+GAP;
      return node;
    });
  }

  const sNodes = layoutNodes(srcNodes, SRC_X);
  const uNodes = layoutNodes(useNodes, USE_X);

  svg.attr('viewBox',`0 0 ${W} ${H}`).attr('height',H);

  // Ribbon path
  function ribbon(sy0,sy1,uy0,uy1) {
    const x0=SRC_X+NODE_W, x1=USE_X, cp=(x1-x0)*.5;
    return `M${x0},${sy0} C${x0+cp},${sy0} ${x1-cp},${uy0} ${x1},${uy0}
            L${x1},${uy1} C${x1-cp},${uy1} ${x0+cp},${sy1} ${x0},${sy1} Z`;
  }

  // Build links
  const links=[];
  const sFill=sNodes.map(()=>0);
  const uFill=uNodes.map(()=>0);

  sNodes.forEach((sn,si)=>{
    uNodes.forEach((un,ui)=>{
      const sBand = sn.h*(un.v/totalUse);
      const uBand = un.h*(sn.v/totalSrc);
      if(Math.min(sBand,uBand)<0.4){sFill[si]+=sBand;uFill[ui]+=uBand;return;}
      links.push({
        sn,un,
        sy0:sn.y+sFill[si], sy1:sn.y+sFill[si]+sBand,
        uy0:un.y+uFill[ui], uy1:un.y+uFill[ui]+uBand,
        color:sn.color,
        value:sn.v*(un.v/totalUse),
      });
      sFill[si]+=sBand; uFill[ui]+=uBand;
    });
  });

  const tt=document.getElementById('tt');

  // Draw links
  svg.append('g').selectAll('path')
    .data(links).join('path')
    .attr('class','link')
    .attr('d',l=>ribbon(l.sy0,l.sy1,l.uy0,l.uy1))
    .attr('fill',l=>l.color)
    .attr('opacity',0.2)
    .on('mouseover',function(ev,l){
      d3.select(this).attr('opacity',0.65);
      tt.style.opacity=1;
      tt.innerHTML=`<strong>${l.sn.name}</strong><br>→ <strong>${l.un.name}</strong><span class="tt-val">~£${l.value.toFixed(1)}m</span><span class="tt-pct">${((l.value/totalSrc)*100).toFixed(1)}% of total income</span>`;
    })
    .on('mousemove',ev=>{tt.style.left=(ev.clientX+16)+'px';tt.style.top=(ev.clientY-36)+'px';})
    .on('mouseout',function(){d3.select(this).attr('opacity',0.2);tt.style.opacity=0;});

  // Source nodes
  const sg=svg.append('g');
  sNodes.forEach(n=>{
    sg.append('rect').attr('class','node-rect')
      .attr('x',n.x).attr('y',n.y).attr('width',NODE_W).attr('height',n.h).attr('rx',3)
      .attr('fill',n.color).attr('opacity', selectedNode===n.id ? 1.0 : .8).attr('stroke', selectedNode===n.id ? 'rgba(255,255,255,0.3)' : 'none').attr('stroke-width', 1)
      .on('click',()=>selectNode(n.id))
      .on('mouseover',function(ev){
        tt.style.opacity=1;
        let html=`<strong>${n.name}</strong><span class="tt-val">${fmt(n.v)}</span><span class="tt-pct">${((n.v/totalSrc)*100).toFixed(1)}% of income</span>`;
        if(NODE_NOTES[n.id]) html+=`<br><span style="font-size:10px;color:var(--text-dim);margin-top:4px;display:block">${NODE_NOTES[n.id]}</span>`;
        tt.innerHTML=html;
      })
      .on('mousemove',ev=>{tt.style.left=(ev.clientX+16)+'px';tt.style.top=(ev.clientY-36)+'px';})
      .on('mouseout',()=>{tt.style.opacity=0;});

    const mid=n.y+n.h/2;
    sg.append('text').attr('class','node-label').attr('x',n.x-LP).attr('y',mid-(n.h>18?5:0))
      .attr('text-anchor','end').attr('dominant-baseline','middle')
      .attr('font-size',n.h>14?11.5:10).text(n.name);
    if(n.h>18)
      sg.append('text').attr('class','node-value').attr('x',n.x-LP).attr('y',mid+7)
        .attr('text-anchor','end').attr('dominant-baseline','middle')
        .attr('font-size',10).text(fmt(n.v));
  });

  // Use nodes
  const ug=svg.append('g');
  uNodes.forEach(n=>{
    ug.append('rect').attr('class','node-rect')
      .attr('x',n.x).attr('y',n.y).attr('width',NODE_W).attr('height',n.h).attr('rx',3)
      .attr('fill',n.color).attr('opacity', selectedNode===n.id ? 1.0 : .8).attr('stroke', selectedNode===n.id ? 'rgba(255,255,255,0.3)' : 'none').attr('stroke-width', 1)
      .on('click',()=>selectNode(n.id))
      .on('mouseover',function(ev){
        tt.style.opacity=1;
        let html=`<strong>${n.name}</strong><span class="tt-val">${fmt(n.v)}</span><span class="tt-pct">${((n.v/totalUse)*100).toFixed(1)}% of expenditure</span>`;
        if(NODE_NOTES[n.id]) html+=`<br><span style="font-size:10px;color:var(--text-dim);margin-top:4px;display:block">${NODE_NOTES[n.id]}</span>`;
        tt.innerHTML=html;
      })
      .on('mousemove',ev=>{tt.style.left=(ev.clientX+16)+'px';tt.style.top=(ev.clientY-36)+'px';})
      .on('mouseout',()=>{tt.style.opacity=0;});

    const mid=n.y+n.h/2;
    ug.append('text').attr('class','node-label').attr('x',n.x+NODE_W+LP).attr('y',mid-(n.h>18?5:0))
      .attr('text-anchor','start').attr('dominant-baseline','middle')
      .attr('font-size',n.h>14?11.5:10).text(n.name);
    if(n.h>18)
      ug.append('text').attr('class','node-value').attr('x',n.x+NODE_W+LP).attr('y',mid+7)
        .attr('text-anchor','start').attr('dominant-baseline','middle')
        .attr('font-size',10).text(fmt(n.v));
  });

  // Column headers
  const hg=svg.append('g');
  hg.append('text').attr('class','col-header').attr('x',SRC_X).attr('y',TOP-14)
    .attr('font-size',12).attr('font-weight','600').attr('fill','#4a9eff').attr('opacity',.8).text('SOURCES OF FUNDS');
  hg.append('text').attr('class','col-header').attr('x',USE_X+NODE_W).attr('y',TOP-14)
    .attr('font-size',12).attr('font-weight','600').attr('fill','#2dd4a0').attr('opacity',.8).text('USES OF FUNDS');

  // Totals
  const sb=sNodes[sNodes.length-1], ub=uNodes[uNodes.length-1];
  hg.append('text').attr('x',SRC_X).attr('y',sb.y+sb.h+18)
    .attr('font-size',12).attr('font-weight','500').attr('fill','#4a9eff').attr('opacity',.7)
    .text(`Total: £${totalSrc.toFixed(0)}m${showReal?' (real)':''}`);
  hg.append('text').attr('x',USE_X+NODE_W+LP).attr('y',ub.y+ub.h+18)
    .attr('font-size',12).attr('font-weight','500').attr('fill','#2dd4a0').attr('opacity',.7)
    .text(`Total: £${totalUse.toFixed(0)}m${showReal?' (real)':''}`);
}

// ── Time series ───────────────────────────────────────────────────────────────
function selectNode(id) {
  selectedNode = id;
  // Fade the hint after first click
  const hint = document.getElementById('hint');
  if (hint) hint.classList.add('faded');
  drawSankey();
  drawTS(id);
  showNodeDesc(id);
}

function showNodeDesc(id) {
  const desc = NODE_DESC[id];
  const panel = document.getElementById('ts-desc');
  const body = document.getElementById('ts-desc-body');
  const source = document.getElementById('ts-desc-source');
  if (desc && panel) {
    body.textContent = desc.body;
    source.textContent = 'Source: ' + desc.source;
    panel.style.display = 'block';
  } else if (panel) {
    panel.style.display = 'none';
  }
}

function closeTS() {
  selectedNode=null;
  document.getElementById('ts-panel').classList.add('hidden');
  const dp = document.getElementById('ts-desc');
  if(dp) dp.style.display='none';
  drawSankey();
}

function drawTS(id) {
  const panel=document.getElementById('ts-panel');
  panel.classList.remove('hidden');

  const label=NODE_LABELS[id]||id;
  document.getElementById('ts-title').textContent=label+' — '+(showReal?'real terms ('+CPI_BASE_LABEL+')':'nominal') + ' · 2017–18 to 2026–27';

  const isSrc = SOURCES.some(s=>s.id===id);
  const node = [...SOURCES,...USES].find(n=>n.id===id);
  const color = node ? node.color : '#4a9eff';

  // Build data series
  const series = YEARS.map(y=>({year:y,value: showReal ? deflate(y, getVal(y,id)) : getVal(y,id),type:YEAR_TYPES[y]}))
                      .filter(d=>d.value>0);

  if(series.length<2){
    document.getElementById('ts-subtitle').textContent='Insufficient data across years';
    return;
  }

  // Delta from first to latest actual
  const actuals=series.filter(d=>d.type==='actuals');
  let sub='';
  if(actuals.length>=2){
    const first=actuals[0], last=actuals[actuals.length-1];
    const pct=((last.value-first.value)/first.value*100).toFixed(1);
    const abs=(last.value-first.value).toFixed(1);
    sub=`${first.year}: £${first.value.toFixed(1)}m → ${last.year}: £${last.value.toFixed(1)}m  (${pct>0?'+':''}${pct}%, ${abs>0?'+':''}£${abs}m)`;
  }
  document.getElementById('ts-subtitle').textContent=sub;

  const svg=d3.select('#ts-svg');
  svg.selectAll('*').remove();

  const W=svg.node().getBoundingClientRect().width||900;
  const H=160, PAD={t:15,r:20,b:30,l:50};
  const iW=W-PAD.l-PAD.r, iH=H-PAD.t-PAD.b;
  svg.attr('viewBox',`0 0 ${W} ${H}`);

  const xScale=d3.scalePoint().domain(series.map(d=>d.year)).range([0,iW]).padding(.1);
  const yMin=d3.min(series,d=>d.value)*.88;
  const yMax=d3.max(series,d=>d.value)*1.06;
  const yScale=d3.scaleLinear().domain([yMin,yMax]).range([iH,0]);

  const g=svg.append('g').attr('transform',`translate(${PAD.l},${PAD.t})`);

  // Grid lines
  const ticks=yScale.ticks(4);
  g.append('g').selectAll('line').data(ticks).join('line')
    .attr('x1',0).attr('x2',iW)
    .attr('y1',d=>yScale(d)).attr('y2',d=>yScale(d))
    .attr('stroke','rgba(255,255,255,.05)').attr('stroke-width',1);

  // Y axis labels
  g.append('g').selectAll('text').data(ticks).join('text')
    .attr('x',-8).attr('y',d=>yScale(d))
    .attr('text-anchor','end').attr('dominant-baseline','middle')
    .attr('font-size',9).attr('fill','rgba(255,255,255,.3)')
    .text(d=>'£'+d.toFixed(0)+'m');

  // Area fill
  const area=d3.area()
    .x(d=>xScale(d.year)).y0(iH).y1(d=>yScale(d.value))
    .curve(d3.curveMonotoneX);
  g.append('path').datum(series).attr('d',area)
    .attr('fill',color).attr('opacity',.08);

  // Line
  const line=d3.line().x(d=>xScale(d.year)).y(d=>yScale(d.value)).curve(d3.curveMonotoneX);

  // Actuals segment
  const actualSeries=series.filter(d=>d.type==='actuals');
  const budgetSeries=series.filter(d=>d.type!=='actuals');

  if(actualSeries.length>1){
    g.append('path').datum(actualSeries).attr('d',line)
      .attr('fill','none').attr('stroke',color).attr('stroke-width',2).attr('opacity',.9);
  }
  if(budgetSeries.length>0 && actualSeries.length>0){
    // Connect from last actual to first budget
    const bridge=[actualSeries[actualSeries.length-1],...budgetSeries];
    g.append('path').datum(bridge).attr('d',line)
      .attr('fill','none').attr('stroke',color).attr('stroke-width',1.5)
      .attr('stroke-dasharray','4,3').attr('opacity',.5);
  }

  // Dots
  g.append('g').selectAll('circle').data(series).join('circle')
    .attr('cx',d=>xScale(d.year)).attr('cy',d=>yScale(d.value)).attr('r',3)
    .attr('fill',d=>d.type==='actuals'?color:'transparent')
    .attr('stroke',color).attr('stroke-width',1.5).attr('opacity',.9);

  // X axis labels
  g.append('g').selectAll('text').data(series).join('text')
    .attr('x',d=>xScale(d.year)).attr('y',iH+18)
    .attr('text-anchor','middle').attr('font-size',9).attr('fill','rgba(255,255,255,.3)')
    .text(d=>d.year.slice(2,4)+'/'+d.year.slice(5,7));

  // Budget label
  if(budgetSeries.length>0){
    g.append('text').attr('x',xScale(budgetSeries[0].year)).attr('y',-4)
      .attr('text-anchor','middle').attr('font-size',8.5).attr('fill',color).attr('opacity',.5)
      .text('← budget →');
  }

  // Value labels on dots (only for actuals with enough space)
  if(series.length<=8){
    g.append('g').selectAll('text').data(actualSeries).join('text')
      .attr('x',d=>xScale(d.year)).attr('y',d=>yScale(d.value)-10)
      .attr('text-anchor','middle').attr('font-size',9).attr('fill',color).attr('opacity',.7)
      .text(d=>'£'+d.value.toFixed(0)+'m');
  }
}

// ── Stocks panel ──────────────────────────────────────────────────────────────
function updateStocks() {
  const data=RAW[currentYear]||{};
  const prev=RAW[YEARS[Math.max(0,YEARS.indexOf(currentYear)-1)]]||{};
  const prevYear=YEARS[Math.max(0,YEARS.indexOf(currentYear)-1)];
  function d(field){ return showReal ? deflate(currentYear, data[field]||0) : (data[field]||0); }
  function dp(field){ return showReal ? deflate(prevYear, prev[field]||0) : (prev[field]||0); }

  function trendClass(cur,prv){
    if(cur==null||prv==null) return 'flat';
    return cur>prv?'up':cur<prv?'down':'flat';
  }
  function trendLabel(cur,prv,invert=false){
    if(cur==null||prv==null) return '';
    const pct=((cur-prv)/Math.abs(prv)*100).toFixed(1);
    const sign=pct>0?'↑':'↓';
    return `${sign} ${Math.abs(pct)}% vs prior year`;
  }

  const stocks=[
    {
      label:'NI Fund balance',
      value:d('ni_fund_cf'), prev:dp('ni_fund_cf'),
      sub:'National Insurance Fund est. value',
      invert:false,
    },
    {
      label:'Capital account balance',
      value:d('cap_balance_cf'), prev:dp('cap_balance_cf'),
      sub:'Government capital account C/F',
      invert:false,
    },
    {
      label:'Pension revenue liability',
      value:d('pension_rev_liability'), prev:dp('pension_rev_liability'),
      sub:'Annual cash call net of contributions',
      invert:true,
    },
    {
      label:'Surplus / deficit',
      value:d('surplus'), prev:dp('surplus'),
      sub:'Revenue account outturn',
      invert:false,
    },
    {
      label:'Total income',
      value:d('total_income'), prev:dp('total_income'),
      sub:'All sources combined',
      invert:false,
    },
    {
      label:'Total expenditure',
      value:d('total_exp'), prev:dp('total_exp'),
      sub:'Pre reserves transfers',
      invert:true,
    },
  ];

  const grid=document.getElementById('stocks-grid');
  grid.innerHTML='';
  stocks.forEach(s=>{
    const tc=trendClass(s.value,s.prev);
    const tc2=s.invert?(tc==='up'?'down':tc==='down'?'up':'flat'):tc;
    const tl=trendLabel(s.value,s.prev);
    grid.innerHTML+=`
      <div class="stock-card">
        <div class="stock-label">${s.label}</div>
        <div class="stock-value">${s.value!=null?'£'+s.value.toFixed(1)+'m':'—'}</div>
        <div class="stock-sub">${s.sub}</div>
        ${tl?`<div class="stock-trend ${tc2}">${tl}</div>`:''}
      </div>`;
  });
}

// ── Add-year form ─────────────────────────────────────────────────────────────
// (Preserved from v1 but simplified — users can add years by editing the JSON)

// ── Init ──────────────────────────────────────────────────────────────────────
buildControls();
buildModeControls();
buildLegend();
drawSankey();
updateStocks();

// Handle resize
window.addEventListener('resize',()=>{
  drawSankey();
  if(selectedNode) drawTS(selectedNode);
  updateStocks();
});
</script>
</body>
</html>
