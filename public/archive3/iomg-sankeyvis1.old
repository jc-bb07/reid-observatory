    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>
<body class="single-view">
<div id="app">

<header>
  <h1>Isle of Man Government <em>— Sources &amp; Uses of Funds</em></h1>
  <p class="subtitle">Revenue flows from taxation and other income through to expenditure. Ribbon width is proportional to value. All figures £ million.</p>
<p class="hint" id="hint">↙ Click any node to see its trend over time and what it contains &nbsp;·&nbsp; hover ribbons to see individual flows</p>
</header>

<div class="controls" id="year-controls"></div>
<div class="controls" style="margin-top:-.8rem;margin-bottom:1.2rem" id="mode-controls"></div>

<div id="sankey-wrap"><svg id="sankey-svg"></svg></div>

<div class="legend" id="legend"></div>

<div id="ts-panel" class="hidden">
  <div id="ts-header">
    <div>
      <div id="ts-title">—</div>
      <div id="ts-subtitle">Click any node to see its trend</div>
    </div>
    <button id="ts-close" onclick="closeTS()">Close</button>
  </div>
  <div id="ts-chart"><svg id="ts-svg" height="160"></svg></div>
</div>

<div id="stocks-panel">
  <h2>Reserve stocks</h2>
  <div class="stocks-grid" id="stocks-grid"></div>
</div>

<div class="source-note">
  <div class="source-note-grid">
    <div>
      <div class="source-note-label">What this shows</div>
      This diagram traces the annual revenue flows of the Isle of Man Government — where money comes in (taxes, NI, fees) and where it goes (staff, welfare, pensions, reserves). It shows <em>flows</em> through the revenue account in a given year, not accumulated stocks or balance sheet positions.
    </div>
    <div>
      <div class="source-note-label">Data sources</div>
      IoM Treasury Pink Books 2017-18 through 2026-27 (Tables 3A, 15, 16, 2) · Statistics IoM National Income Report 2023-24 · 2025-26 and 2026-27 are budget projections · 2020-21 NI welfare includes c.£73m COVID payments (Salary Support Scheme, MERA) · Customs &amp; VAT calculated under FERSA; current indexation based on 2018-19 survey
    </div>
  </div>
</div>

  <div class="page-footer">
    <span>observatory.coalfinch.com · Crown Dependencies Re-Identification Observatory · <a href="mailto:observatory@coalfinch.com">observatory@coalfinch.com</a></span>
    <span>IoM fiscal flows · 2024–25 · <a href="https://coalfinch.com">Coalfinch</a></span>
  </div>

</div><!-- /app -->
<div id="tt"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>

<script>
// ═══════════════════════════════════════════════════════════════════════════════
// DATA
