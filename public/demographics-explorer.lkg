const DEP_L=[1951,1961,1971,1976,1981,1986,1991,1996,2001,2006,2011,2016,2021,2026];
const DEP={
  iom:   [null,null,null,45.3,42.8,42.2,37.2,34.6,31.3,32.3,34.6,35.9,33.1,39.4],
  jersey:[18.7,19.9,21.4,null,22.0,null,20.1,null,20.5,null,21.2,null,27.1,28.9],
  gue:   [null,null,null,null,null,null,null,null,null,null,26.0,28.0,34.0,37.7],
  uk:    [null,null,17.9,18.9,23.0,23.8,24.3,24.4,24.8,25.5,26.5,28.1,29.5,31.3],
};
const PROJ_L=[2021,2025,2030,2035,2040];
const PROJ={
  iom:[58.3,60.0,63.0,67.0,71.0],
  jersey_nil:[52.0,54.5,57.8,61.0,64.2],jersey_400:[52.0,53.8,56.0,58.0,60.0],jersey_800:[52.0,53.0,54.5,56.5,58.0],
  gue:[55.0,57.5,61.0,65.0,69.0],uk:[56.0,57.0,58.5,60.5,62.0],
};

const gc='rgba(255,255,255,0.05)',tc='rgba(200,220,235,0.5)',zc='rgba(200,220,235,0.20)';
const lerp=(a,b,t)=>a+(b-a)*t;
const lerpDS=(d1,d2,t)=>({m:d1.m.map((v,i)=>lerp(v,d2.m[i],t)),f:d1.f.map((v,i)=>lerp(v,d2.f[i],t))});

// Multi-year interpolation: sliderVal 0-100 maps across 4 census years
// 0=1996, 33.3=2001, 66.6=2011, 100=2021
function getInterpDS(key, sv) {
  const n = CENSUS_YEARS.length - 1; // 3 segments
  const pos = sv / 100 * n;
  const seg = Math.min(Math.floor(pos), n-1);
  const t = pos - seg;
  const y1 = CENSUS_YEARS[seg];
  const y2 = CENSUS_YEARS[seg+1];
  return lerpDS(PYR[key][y1], PYR[key][y2], t);
}

function getInterpYear(sv) {
  const n = CENSUS_YEARS.length - 1;
  const pos = sv / 100 * n;
  const seg = Math.min(Math.floor(pos), n-1);
  const t = pos - seg;
  return Math.round(lerp(CENSUS_YEARS[seg], CENSUS_YEARS[seg+1], t));
}

function getInterpPop(key, sv) {
  const n = CENSUS_YEARS.length - 1;
  const pos = sv / 100 * n;
  const seg = Math.min(Math.floor(pos), n-1);
  const t = pos - seg;
  const y1 = CENSUS_YEARS[seg];
  const y2 = CENSUS_YEARS[seg+1];
  return Math.round(lerp(META[key].pop[y1], META[key].pop[y2], t));
}

function getInterpMedian(key, sv) {
  const n = CENSUS_YEARS.length - 1;
  const pos = sv / 100 * n;
  const seg = Math.min(Math.floor(pos), n-1);
  const t = pos - seg;
  const y1 = CENSUS_YEARS[seg];
  const y2 = CENSUS_YEARS[seg+1];
  return lerp(META[key].median[y1], META[key].median[y2], t);
}

let animDur=4000;
let audience='plain';
let pyrMode='single';
let singleIsland='iom';
let strIsland='all',strYear=1996,scenario='nil';
let sliderVal=0,animPlaying=false,animRaf=null;
let depCI=null,diffCI=null,strCI=null,projCI=null;

function updateSpeed(v){
  const durations={1:10000,2:7000,3:4000,4:2000,5:1000};
  const labels={1:'Slow',2:'Slower',3:'Normal',4:'Faster',5:'Fast'};
  animDur=durations[v];
  document.getElementById('speedLabel').textContent=labels[v];
}

function setAudience(a){
  audience=a;
  document.getElementById('btn-plain').classList.toggle('active',a==='plain');
  document.getElementById('btn-tech').classList.toggle('active',a==='tech');
  document.querySelectorAll('.plain-box').forEach(el=>el.classList.toggle('hidden',a==='tech'));
}

const TAB_IDS=['population','dependency','differential','pyramids','structure','projections'];
function showTab(id){
  TAB_IDS.forEach(t=>document.getElementById('tab-'+t).style.display=t===id?'':'none');
  document.querySelectorAll('.tab').forEach((b,i)=>b.classList.toggle('active',TAB_IDS[i]===id));
  if(id==='population')renderPopChart();
  if(id==='differential'&&!diffCI)initDiffChart();
  if(id==='structure')renderStructure();
  if(id==='projections')renderProjections();
}

function cOpts(yLabel,yMin,yMax,stepSize,xMin,xMax){
  return{responsive:true,maintainAspectRatio:false,
    interaction:{mode:'index',intersect:false},
    plugins:{legend:{display:false},tooltip:{
      backgroundColor:'#0d1b2a',borderColor:'rgba(78,201,168,0.25)',borderWidth:1,
      titleColor:tc,bodyColor:'rgba(200,220,235,0.85)',padding:10,
      callbacks:{label:ctx=>ctx.parsed.y!=null?` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%`:null}
    }},
    scales:{
      x:{type:'linear',min:xMin||1951,max:xMax||2026,ticks:{color:tc,font:{size:10},stepSize:10,maxRotation:0,callback:v=>v},grid:{color:gc},border:{color:'#1d3148'}},
      y:{min:yMin,max:yMax,ticks:{color:tc,font:{size:10},callback:v=>v+'%',stepSize:stepSize||5},grid:{color:gc},border:{color:'#1d3148'},title:{display:true,text:yLabel,color:tc,font:{size:10}}}
    }
  };
}

function initDepChart(){
  if(depCI)depCI.destroy();
  depCI=new Chart(document.getElementById('depChart'),{
    type:'line',
    data:{labels:DEP_L,datasets:[
      {label:'Isle of Man',data:DEP.iom,borderColor:'#4ec9a8',pointBackgroundColor:'#4ec9a8',pointRadius:4,borderWidth:2.5,spanGaps:false,tension:0.35,fill:false},
      {label:'Jersey',data:DEP.jersey,borderColor:'#f5a623',pointBackgroundColor:'#f5a623',pointRadius:4,borderWidth:2,spanGaps:true,tension:0.35,fill:false},
      {label:'Guernsey',data:DEP.gue,borderColor:'#e06b6b',pointBackgroundColor:'#e06b6b',pointRadius:4,borderWidth:2,spanGaps:true,tension:0.35,fill:false},
      {label:'UK',data:DEP.uk,borderColor:'#8fa8bf',pointBackgroundColor:'#8fa8bf',pointRadius:3,borderWidth:1.5,borderDash:[5,4],spanGaps:false,tension:0.35,fill:false},
    ]},
    options:cOpts('65+ as % of 15–64',15,50,5,1951,2026),
  });
}

function initDiffChart(){
  if(diffCI)diffCI.destroy();
  // Only include years from 1971 onwards
  const filteredLabels=DEP_L.filter(y=>y>=1971);
  const diff=k=>filteredLabels.map(y=>{
    const i=DEP_L.indexOf(y);
    const iv=DEP[k][i],uv=DEP.uk[i];
    return (iv!=null&&uv!=null)?+(iv-uv).toFixed(2):null;
  });
  const opts=cOpts('Island − UK (percentage points)',-12,20,5,1971,2026);
  opts.scales.y.ticks.callback=v=>(v>0?'+':'')+v+' pts';
  opts.scales.y.grid={color:ctx=>ctx.tick.value===0?zc:gc,lineWidth:ctx=>ctx.tick.value===0?1.5:1};
  opts.plugins.tooltip.callbacks.label=ctx=>{
    if(ctx.parsed.y==null)return null;
    const v=ctx.parsed.y;
    return ` ${ctx.dataset.label}: ${v>0?'+':''}${v.toFixed(1)} pts`;
  };
  diffCI=new Chart(document.getElementById('diffChart'),{
    type:'line',
    data:{labels:filteredLabels,datasets:[
      {label:'Isle of Man − UK',data:diff('iom'),borderColor:'#4ec9a8',pointBackgroundColor:'#4ec9a8',
       fill:{target:{value:0},above:'rgba(78,201,168,0.10)',below:'rgba(224,107,107,0.08)'},
       pointRadius:4,borderWidth:2.5,spanGaps:true,tension:0.35},
      {label:'Jersey − UK',data:diff('jersey'),borderColor:'#f5a623',pointBackgroundColor:'#f5a623',
       fill:false,pointRadius:4,borderWidth:2,spanGaps:true,tension:0.35},
      {label:'Guernsey − UK',data:diff('gue'),borderColor:'#e06b6b',pointBackgroundColor:'#e06b6b',
       fill:false,pointRadius:4,borderWidth:2,spanGaps:true,tension:0.35},
    ]},
    options:opts,
  });
}

// ── PYRAMIDS ──────────────────────────────────────────────────────────────────
function setPyrMode(m){
  pyrMode=m;
  ['single','dual','quad'].forEach(x=>document.getElementById('pyr-'+x).classList.toggle('active',x===m));
  document.getElementById('pyr-island-ctrl').style.display=m==='single'?'flex':'none';
  document.getElementById('pyr-dual-ctrl').style.display=m==='dual'?'flex':'none';
  renderPyramids();
}
function setSingleIsland(k,btn){
  singleIsland=k;
  document.querySelectorAll('#pyr-island-ctrl .pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');renderPyramids();
}
function setYear(v){sliderVal=v;document.getElementById('yearSlider').value=v;updateYearDisplay();renderPyramids();}
function onSlider(v){
  animPlaying=false;
  const btn=document.getElementById('animBtn');
  btn.classList.remove('playing');btn.textContent='▶ Animate';
  if(animRaf){cancelAnimationFrame(animRaf);animRaf=null;}
  sliderVal=+v;updateYearDisplay();renderPyramids();
}
function updateYearDisplay(){
  const yr=getInterpYear(sliderVal);
  const isEst=yr>2021;
  const el=document.getElementById('yearDisplay');
  el.textContent=yr+(isEst?' ~':'');
  el.style.color=isEst?'rgba(245,166,35,0.75)':'var(--accent)';
}
function toggleAnim(){
  if(animPlaying){
    animPlaying=false;
    const btn=document.getElementById('animBtn');btn.classList.remove('playing');btn.textContent='▶ Animate';
    if(animRaf){cancelAnimationFrame(animRaf);animRaf=null;}return;
  }
  animPlaying=true;
  const btn=document.getElementById('animBtn');btn.classList.add('playing');btn.textContent='■ Stop';
  // Always animate from 2011 to 2021
  sliderVal=0;
  document.getElementById('yearSlider').value=0;
  updateYearDisplay();renderPyramids();
  const start=performance.now(),dur=animDur;
  const tick=now=>{
    const raw=Math.min((now-start)/dur,1);
    const e=raw<0.5?2*raw*raw:-1+(4-2*raw)*raw;
    sliderVal=lerp(0,100,e);
    document.getElementById('yearSlider').value=sliderVal;
    updateYearDisplay();renderPyramids();
    if(raw<1&&animPlaying)animRaf=requestAnimationFrame(tick);
    else{animPlaying=false;btn.classList.remove('playing');btn.textContent='▶ Animate';}
  };
  animRaf=requestAnimationFrame(tick);
}

function renderPyramids(){
  // Overlay: show ghost of nearest census year when animating between years
  const n=CENSUS_YEARS.length-1;
  const pos=sliderVal/100*n;
  const seg=Math.min(Math.floor(pos),n-1);
  const t=pos-seg;
  const showOv=t>0.04&&t<0.96;
  const nearYear=CENSUS_YEARS[seg];

  const container=document.getElementById('pyrContainer');
  container.innerHTML='';

  if(pyrMode==='single'){
    const d=getInterpDS(singleIsland,sliderVal);
    container.appendChild(makePyr(singleIsland,d,showOv?PYR[singleIsland][nearYear]:null,false));
  } else if(pyrMode==='dual'){
    const kA=document.getElementById('dualA').value;
    const kB=document.getElementById('dualB').value;
    const dA=getInterpDS(kA,sliderVal);
    const dB=getInterpDS(kB,sliderVal);
    container.appendChild(makePyr(kA,dA,null,true));
    container.appendChild(makeDiffPyr(kA,kB,dA,dB));
    container.appendChild(makePyr(kB,dB,null,true));
  } else {
    Object.keys(PYR).forEach(k=>{
      const d=getInterpDS(k,sliderVal);
      container.appendChild(makePyr(k,d,null,true));
    });
  }

  // Stats
  const stats=document.getElementById('pyrStats');
  stats.innerHTML='';
  const keys=pyrMode==='single'?[singleIsland]:pyrMode==='dual'?
    [document.getElementById('dualA').value,document.getElementById('dualB').value]:Object.keys(PYR);
  keys.forEach(k=>{
    const m=META[k];
    const d=getInterpDS(k,sliderVal);
    const over65=[...d.m.slice(13),...d.f.slice(13)].reduce((a,b)=>a+b,0);
    const med=getInterpMedian(k,sliderVal);
    const pop=getInterpPop(k,sliderVal);
    const qual=PYR_QUALITY[k][CENSUS_YEARS[Math.min(Math.floor(sliderVal/100*(CENSUS_YEARS.length-1)),CENSUS_YEARS.length-2)]];
    const div=document.createElement('div');
    div.className='card';div.style.borderTop=`2px solid ${m.color}`;
    div.innerHTML=`<div class="card-label">${m.label}${qual==='estimated'?'<span style="font-size:9px;color:#f5a623;margin-left:5px">est.</span>':''}</div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:4px">
        <div><div style="font-size:10px;color:var(--text-f)">Pop</div><div style="font-size:13px;font-variant-numeric:tabular-nums;color:var(--text)">${k==='uk'?(pop/1e6).toFixed(1)+'M':pop.toLocaleString()}</div></div>
        <div><div style="font-size:10px;color:var(--text-f)">Median age</div><div style="font-size:13px;font-variant-numeric:tabular-nums;color:${m.color}">${med.toFixed(1)} yrs</div></div>
        <div><div style="font-size:10px;color:var(--text-f)">65+</div><div style="font-size:13px;font-variant-numeric:tabular-nums;color:var(--text)">${over65.toFixed(1)}%</div></div>
      </div>`;
    stats.appendChild(div);
  });
}

function makePyr(key,data,ov,compact){
  const m=META[key];
  const maxV=5.5,barH=compact?10:14,gap=2,totalH=BANDS.length*(barH+gap);
  const svgW=compact?260:320,lw=32,cw=(svgW-lw*2-6)/2,cx=lw+cw+3;
  const ns='http://www.w3.org/2000/svg';
  const wrap=document.createElement('div');wrap.className='pyramid-item';
  wrap.style.alignSelf='flex-start';
  wrap.innerHTML=`<div style="text-align:center;margin-bottom:6px;height:22px;display:flex;align-items:center;justify-content:center"><span class="pyr-name" style="color:${m.color}">${m.label}</span></div>
    <div class="pyr-mf" style="height:16px"><span style="color:#8fa8bf">◀ M</span><span style="color:#f5a623">F ▶</span></div>`;
  const svg=document.createElementNS(ns,'svg');
  svg.setAttribute('width','100%');
  svg.setAttribute('height',totalH);
  svg.setAttribute('viewBox',`0 0 ${svgW} ${totalH}`);
  svg.setAttribute('preserveAspectRatio','none');
  svg.style.cssText='display:block;overflow:visible';
  BANDS.forEach((band,i)=>{
    const y=(BANDS.length-1-i)*(barH+gap);
    const mW=Math.max(0,(data.m[i]/maxV)*cw),fW=Math.max(0,(data.f[i]/maxV)*cw);
    // Working age (15-64) = bands 3-12, dependent = 0-2 (under 15) and 13-16 (65+)
    const isWorking = i>=3 && i<=12;
    const maleCol   = isWorking ? '#8fa8bf' : '#7b9ea8';
    const femaleCol = isWorking ? '#f5a623' : '#e06b6b';
    const opacity   = isWorking ? '0.85' : '0.60';
    const mkR=(x,w,fill,op)=>{if(w<=0)return null;const r=document.createElementNS(ns,'rect');r.setAttribute('x',x);r.setAttribute('y',y);r.setAttribute('width',w);r.setAttribute('height',barH);r.setAttribute('fill',fill);r.setAttribute('opacity',op);r.setAttribute('rx','1');return r;};
    const r1=mkR(cx-mW,mW,maleCol,opacity);if(r1)svg.appendChild(r1);
    const r2=mkR(cx,fW,femaleCol,opacity);if(r2)svg.appendChild(r2);
    if(ov){
      const moW=Math.max(0,(ov.m[i]/maxV)*cw),foW=Math.max(0,(ov.f[i]/maxV)*cw);
      const mkO=(x,w,stroke)=>{if(w<=0)return null;const r=document.createElementNS(ns,'rect');r.setAttribute('x',x);r.setAttribute('y',y);r.setAttribute('width',w);r.setAttribute('height',barH);r.setAttribute('fill','none');r.setAttribute('stroke',stroke);r.setAttribute('stroke-width','0.8');r.setAttribute('stroke-dasharray','3 2');r.setAttribute('opacity','0.4');r.setAttribute('rx','1');return r;};
      const o1=mkO(cx-moW,moW,'#8fa8bf');if(o1)svg.appendChild(o1);
      const o2=mkO(cx,foW,'#f5a623');if(o2)svg.appendChild(o2);
    }
    const txt=document.createElementNS(ns,'text');
    txt.setAttribute('x',cx-3);txt.setAttribute('y',y+barH*0.74);txt.setAttribute('text-anchor','end');
    txt.setAttribute('fill','rgba(232,237,242,0.75)');txt.setAttribute('font-size',compact?7:9);
    txt.textContent=band;svg.appendChild(txt);
  });
  const line=document.createElementNS(ns,'line');
  line.setAttribute('x1',cx);line.setAttribute('y1',0);line.setAttribute('x2',cx);line.setAttribute('y2',totalH);
  line.setAttribute('stroke','#1d3148');line.setAttribute('stroke-width','1');svg.appendChild(line);
  wrap.appendChild(svg);
  if(ov){const leg=document.createElement('div');leg.style.cssText='display:flex;justify-content:center;gap:10px;font-size:9px;color:rgba(143,168,191,0.4);margin-top:4px';leg.innerHTML='<span>── 2021</span><span>╌╌ 2011</span>';wrap.appendChild(leg);}
  return wrap;
}

function makeDiffPyr(kA,kB,dA,dB){
  // Shows (A - B) per band, total population share
  // Positive = A has more, negative = B has more
  const mA=META[kA],mB=META[kB];
  const barH=10,gap=2,totalH=BANDS.length*(barH+gap);
  const svgW=160,maxDiff=2.0;
  const halfW=svgW/2-8,cx=svgW/2;
  const ns='http://www.w3.org/2000/svg';
  const wrap=document.createElement('div');
  wrap.className='pyramid-item';
  wrap.style.cssText='min-width:120px;max-width:160px;flex:0 0 140px;align-self:flex-start';
  // Match exact header height of makePyr: name span + pyr-mf div
  wrap.innerHTML=`<div style="text-align:center;margin-bottom:6px;height:22px;display:flex;align-items:center;justify-content:center">
    <span class="pyr-name" style="color:rgba(200,220,235,0.4);font-size:10px">Difference</span>
  </div>
  <div class="pyr-mf" style="height:16px">
    <span style="color:${mA.color};font-size:9px">◀ ${mA.label}</span>
    <span style="color:${mB.color};font-size:9px">${mB.label} ▶</span>
  </div>`;
  const svg=document.createElementNS(ns,'svg');
  svg.setAttribute('width','100%');
  svg.setAttribute('height',totalH);
  svg.setAttribute('viewBox',`0 0 ${svgW} ${totalH}`);
  svg.setAttribute('preserveAspectRatio','none');
  svg.style.cssText='display:block;overflow:visible';
  BANDS.forEach((band,i)=>{
    const y=(BANDS.length-1-i)*(barH+gap);
    // combined % (m+f) for each island per band
    const totA=dA.m[i]+dA.f[i];
    const totB=dB.m[i]+dB.f[i];
    const diff=totA-totB;
    const barW=Math.min(Math.abs(diff)/maxDiff*halfW, halfW);
    const fill=diff>0?mA.color:mB.color;
    const x=diff>0?cx-barW:cx;
    const r=document.createElementNS(ns,'rect');
    r.setAttribute('x',x);r.setAttribute('y',y);r.setAttribute('width',barW);r.setAttribute('height',barH);
    r.setAttribute('fill',fill);r.setAttribute('opacity','0.75');r.setAttribute('rx','1');
    svg.appendChild(r);
    // no band labels in diff panel — main pyramids on either side already show them
  });
  // centre line
  const line=document.createElementNS(ns,'line');
  line.setAttribute('x1',cx);line.setAttribute('y1',0);line.setAttribute('x2',cx);line.setAttribute('y2',totalH);
  line.setAttribute('stroke','#1d3148');line.setAttribute('stroke-width','1');svg.appendChild(line);
  wrap.appendChild(svg);

  // Scale as a separate div below the SVG — keeps SVG height clean
  const scaleDiv=document.createElement('div');
  scaleDiv.style.cssText=`position:relative;width:100%;height:16px;margin-top:2px`;
  [-2,-1,0,1,2].forEach(v=>{
    const pct=((v/maxDiff)*halfW + cx) / svgW * 100;
    const lbl=document.createElement('span');
    lbl.style.cssText=`position:absolute;left:${pct}%;transform:translateX(-50%);font-size:9px;color:rgba(200,220,235,0.6);white-space:nowrap`;
    lbl.textContent=v===0?'0':(v>0?`+${v}%`:`${v}%`);
    scaleDiv.appendChild(lbl);
  });
  wrap.appendChild(scaleDiv);
  return wrap;
}

// ── STRUCTURE ─────────────────────────────────────────────────────────────────
function setStrYear(y,btn){
  strYear=y;
  ['1996','2001','2011','2021'].forEach(x=>document.getElementById('str-'+x).classList.toggle('active',+x===y));
  document.getElementById('str-year-label').textContent=y+' census data';
  renderStructure();
}
function setStrIsland(k,btn){
  strIsland=k;
  document.querySelectorAll('#tab-structure .pill:not(#str-2011):not(#str-2021)').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');renderStructure();
}
function renderStructure(){
  const keys=strIsland==='all'?['iom','jersey','guernsey','uk']:[strIsland];
  const yr=strYear;
  const cards=document.getElementById('strCards');
  cards.innerHTML='';
  keys.forEach(k=>{
    const s=STR[k][yr],m=META[k];
    const d=document.createElement('div');d.className='card';d.style.borderTop=`2px solid ${m.color}`;
    d.innerHTML=`<div class="card-label">${m.label}</div>
      <div class="card-value" style="color:${m.color}">${(s.ret/s.work*100).toFixed(1)}%</div>
      <div class="card-sub">aged dep. ratio · ${yr}</div>
      <div style="margin-top:6px;font-size:10px;color:var(--text-f)">65+: ${s.ret}% &nbsp;|&nbsp; 15–64: ${s.work}%</div>`;
    cards.appendChild(d);
  });
  if(strCI)strCI.destroy();
  const cats=['Pre-school (0–4)','School age (5–14)','Working age (15–64)','Retirement age (65+)'];
  strCI=new Chart(document.getElementById('strChart'),{
    type:'bar',
    data:{labels:cats,datasets:keys.map(k=>({
      label:META[k].label,
      data:[STR[k][yr].pre,STR[k][yr].school,STR[k][yr].work,STR[k][yr].ret],
      backgroundColor:META[k].color+'55',borderColor:META[k].color,borderWidth:1,borderRadius:2,
    }))},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{
        backgroundColor:'#0d1b2a',borderColor:'rgba(78,201,168,0.25)',borderWidth:1,
        titleColor:tc,bodyColor:'rgba(200,220,235,0.85)',padding:10,
        callbacks:{label:ctx=>` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%`}
      }},
      scales:{
        x:{ticks:{color:tc,font:{size:10}},grid:{color:gc},border:{color:'#1d3148'}},
        y:{min:0,max:75,ticks:{color:tc,font:{size:10},callback:v=>v+'%'},grid:{color:gc},border:{color:'#1d3148'}}
      }
    }
  });
}

// ── PROJECTIONS ───────────────────────────────────────────────────────────────
function setScenario(s,btn){
  scenario=s;
  ['nil','400','800'].forEach(x=>document.getElementById('scen-'+x).classList.toggle('active',x===s));
  renderProjections();
}
function renderProjections(){
  if(projCI)projCI.destroy();
  projCI=new Chart(document.getElementById('projChart'),{
    type:'line',
    data:{labels:PROJ_L,datasets:[
      {label:'Isle of Man (est.)',data:PROJ.iom,borderColor:'#4ec9a8',pointBackgroundColor:'#4ec9a8',pointRadius:4,borderWidth:2,borderDash:[6,3],fill:false,tension:0.3},
      {label:'Jersey',data:PROJ['jersey_'+scenario],borderColor:'#f5a623',pointBackgroundColor:'#f5a623',pointRadius:4,borderWidth:2.5,fill:false,tension:0.3},
      {label:'Guernsey',data:PROJ.gue,borderColor:'#e06b6b',pointBackgroundColor:'#e06b6b',pointRadius:4,borderWidth:2.5,fill:false,tension:0.3},
      {label:'UK',data:PROJ.uk,borderColor:'#8fa8bf',pointBackgroundColor:'#8fa8bf',pointRadius:3,borderWidth:1.5,borderDash:[4,3],fill:false,tension:0.3},
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      interaction:{mode:'index',intersect:false},
      plugins:{legend:{display:false},tooltip:{
        backgroundColor:'#0d1b2a',borderColor:'rgba(78,201,168,0.25)',borderWidth:1,
        titleColor:tc,bodyColor:'rgba(200,220,235,0.85)',padding:10,
        callbacks:{label:ctx=>` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%`}
      }},
      scales:{
        x:{type:'linear',min:2021,max:2040,
           ticks:{color:tc,font:{size:10},stepSize:5,maxRotation:0,callback:v=>[2021,2025,2030,2035,2040].includes(v)?v:''},
           grid:{color:gc},border:{color:'#1d3148'}},
        y:{min:45,max:80,ticks:{color:tc,font:{size:10},callback:v=>v+'%',stepSize:5},
           grid:{color:gc},border:{color:'#1d3148'},
           title:{display:true,text:'Total dependency ratio',color:tc,font:{size:10}}}
      }
    }
  });
}


// ── POPULATION CHART ─────────────────────────────────────────────────────────
const POP_DATA = {
  iom:      [[1821,40081],[1831,41161],[1841,47975],[1851,52387],[1861,52469],[1871,54128],[1881,53476],[1891,55598],[1901,54752],[1911,52037],[1921,51013],[1931,49308],[1939,52379],[1951,55123],[1961,48133],[1966,49308],[1971,56289],[1976,60496],[1981,64679],[1986,64282],[1991,69788],[1996,71714],[2001,76315],[2006,80058],[2011,84497],[2016,83314],[2021,84069],[2026,85125]],
  jersey:   [[1821,28600],[1831,36582],[1841,47544],[1851,57020],[1861,55613],[1871,56627],[1881,52445],[1891,54518],[1901,52576],[1911,51898],[1921,49701],[1931,50462],[1939,51000],[1951,57310],[1961,59489],[1971,69329],[1976,71018],[1981,76050],[1986,80212],[1991,84082],[1996,85150],[2001,87186],[2011,97857],[2021,103267],[2026,104820]],
  guernsey: [[1821,20339],[1831,24540],[1841,26693],[1851,29806],[1861,29850],[1871,30680],[1881,32631],[1891,35287],[1901,40474],[1911,41858],[1921,38315],[1931,40643],[1951,43603],[1961,45068],[1971,51458],[1976,53637],[1981,53313],[1986,55482],[1991,58867],[1996,58681],[2001,59807],[2011,62915],[2016,62208],[2021,63448],[2026,64420]],
  uk:       [[1821,14.1],[1831,16.3],[1841,18.5],[1851,20.8],[1861,23.2],[1871,26.1],[1881,29.7],[1891,33.0],[1901,37.0],[1911,40.8],[1921,42.8],[1931,44.8],[1939,47.8],[1951,50.3],[1961,52.8],[1971,55.9],[1976,56.2],[1981,56.4],[1986,56.7],[1991,57.8],[1996,58.8],[2001,59.1],[2006,60.6],[2011,63.3],[2016,65.6],[2021,67.0],[2026,68.5]],
};
// Estimated years (hollow points)
const POP_EST_YEARS = new Set([2026]);

let popRange = 50;
let popIslands = new Set(['iom','jersey','guernsey']);
let showUK = false;
let popCI = null;

function setRange(yrs, btn) {
  popRange = yrs;
  document.querySelectorAll('[id^="range-"]').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderPopChart();
}

function togglePopIsland(key, btn) {
  if (popIslands.has(key)) {
    if (popIslands.size > 1) { popIslands.delete(key); btn.classList.remove('active'); }
  } else {
    popIslands.add(key); btn.classList.add('active');
  }
  renderPopChart();
}

function toggleUK(checked) {
  showUK = checked;
  renderPopChart();
}

function renderPopChart() {
  if (popCI) popCI.destroy();

  const maxYear = 2026;
  const minYear = maxYear - popRange;
  const gc = 'rgba(255,255,255,0.05)', tc = 'rgba(200,220,235,0.5)';

  const islandMeta = {
    iom:      { label:'Isle of Man', color:'#4ec9a8' },
    jersey:   { label:'Jersey',      color:'#f5a623' },
    guernsey: { label:'Guernsey',    color:'#e06b6b' },
  };

  function filterData(pairs) {
    return pairs
      .filter(([y]) => y >= minYear && y <= maxYear)
      .map(([y, v]) => ({ x: y, y: v }));
  }

  function pointStyles(pairs) {
    return pairs
      .filter(([y]) => y >= minYear && y <= maxYear)
      .map(([y]) => POP_EST_YEARS.has(y) ? 'circle' : 'circle');
  }

  function pointRadius(pairs) {
    return pairs
      .filter(([y]) => y >= minYear && y <= maxYear)
      .map(([y]) => 4);
  }

  function borderDash(pairs) {
    // Make the segment to 2026 dashed
    return undefined;
  }

  const datasets = [];

  // Island datasets (left axis)
  [...popIslands].forEach(key => {
    const meta = islandMeta[key];
    const data = filterData(POP_DATA[key]);
    // Separate solid (actual) and estimated (2026) points
    datasets.push({
      label: meta.label,
      data,
      borderColor: meta.color,
      backgroundColor: meta.color,
      pointBackgroundColor: data.map(d => POP_EST_YEARS.has(d.x) ? 'transparent' : meta.color),
      pointBorderColor: meta.color,
      pointRadius: data.map(d => POP_EST_YEARS.has(d.x) ? 5 : 4),
      pointBorderWidth: data.map(d => POP_EST_YEARS.has(d.x) ? 2 : 1),
      borderWidth: 2.5,
      tension: 0.3,
      spanGaps: false,
      yAxisID: 'y',
      segment: {
        borderDash: ctx => {
          const x = ctx.p1.parsed.x;
          return x >= 2021 ? [5,4] : undefined;
        }
      }
    });
  });

  // UK dataset (right axis)
  if (showUK) {
    const ukData = filterData(POP_DATA.uk);
    datasets.push({
      label: 'UK (millions)',
      data: ukData,
      borderColor: '#8fa8bf',
      backgroundColor: '#8fa8bf',
      pointBackgroundColor: ukData.map(d => POP_EST_YEARS.has(d.x) ? 'transparent' : '#8fa8bf'),
      pointBorderColor: '#8fa8bf',
      pointRadius: 3,
      borderWidth: 1.5,
      borderDash: [5,4],
      tension: 0.3,
      spanGaps: false,
      yAxisID: 'y2',
      segment: {
        borderDash: ctx => ctx.p1.parsed.x >= 2021 ? [3,2] : [5,4],
      }
    });
  }

  const scales = {
    x: {
      type: 'linear', min: minYear, max: maxYear,
      ticks: { color: tc, font: { size: 10 }, stepSize: popRange > 100 ? 25 : 10, maxRotation: 0, callback: v => v },
      grid: { color: gc }, border: { color: '#1d3148' }
    },
    y: {
      ticks: { color: tc, font: { size: 10 }, callback: v => v >= 1000 ? (v/1000).toFixed(0)+'k' : v },
      grid: { color: gc }, border: { color: '#1d3148' },
      title: { display: true, text: 'Population', color: tc, font: { size: 10 } }
    }
  };

  if (showUK) {
    scales.y2 = {
      position: 'right',
      ticks: { color: '#8fa8bf', font: { size: 10 }, callback: v => v + 'M' },
      grid: { drawOnChartArea: false },
      border: { color: '#1d3148' },
      title: { display: true, text: 'UK (millions)', color: '#8fa8bf', font: { size: 10 } }
    };
  }

  popCI = new Chart(document.getElementById('popChart'), {
    type: 'line',
    data: { datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0d1b2a',
          borderColor: 'rgba(78,201,168,0.25)', borderWidth: 1,
          titleColor: tc, bodyColor: 'rgba(200,220,235,0.85)', padding: 10,
          callbacks: {
            label: ctx => {
              const v = ctx.parsed.y;
              const est = POP_EST_YEARS.has(ctx.parsed.x) ? ' ~' : '';
              if (ctx.dataset.yAxisID === 'y2') return ` ${ctx.dataset.label}: ${v.toFixed(1)}M${est}`;
              return ` ${ctx.dataset.label}: ${v >= 1000 ? v.toLocaleString() : v}${est}`;
            }
          }
        }
      },
      scales
    }
  });

  // Update stat cards
  const cards = document.getElementById('popCards');
  cards.innerHTML = '';
  [...popIslands].forEach(key => {
    const meta = islandMeta[key];
    const pairs = POP_DATA[key];
    const latest = pairs[pairs.length-1];
    const prev50 = pairs.find(([y]) => y >= latest[0]-52) || pairs[0];
    const change = ((latest[1]-prev50[1])/prev50[1]*100).toFixed(1);
    const div = document.createElement('div');
    div.className = 'card';
    div.style.borderTop = `2px solid ${meta.color}`;
    div.innerHTML = `<div class="card-label">${meta.label}</div>
      <div class="card-value" style="color:${meta.color}">${latest[1].toLocaleString()}</div>
      <div class="card-sub">population ${latest[0]}${POP_EST_YEARS.has(latest[0])?' ~':''}</div>
      <div class="card-${parseFloat(change)>0?'up':'dn'}">${parseFloat(change)>0?'▲':'▼'} ${Math.abs(change)}% since ~${prev50[0]}</div>`;
    cards.appendChild(div);
  });
}

document.addEventListener('DOMContentLoaded',()=>{
  renderPopChart();
  initDepChart();
  // Default: dual mode IoM vs UK, starting at 1996
  pyrMode='dual';
  singleIsland='iom';
  document.getElementById('pyr-single').classList.remove('active');
  document.getElementById('pyr-dual').classList.add('active');
  document.getElementById('pyr-quad').classList.remove('active');
  document.getElementById('pyr-island-ctrl').style.display='none';
  document.getElementById('pyr-dual-ctrl').style.display='flex';
  document.getElementById('dualA').value='iom';
  document.getElementById('dualB').value='uk';
  document.getElementById('yearSlider').value=0;
  sliderVal=0;
  updateYearDisplay();
  renderPyramids();
  strYear=1996;
  renderStructure();
});
</script>
</body>
</html>
